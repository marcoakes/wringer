# The harness image builds this Bun checkout. Keep host state, secrets,
# dependency directories and old local artifacts out of its build context.
node_modules
**/node_modules
ts
.claude
.codex
.agents

# git history and CI definitions
.git
.gitignore
.github

# local environments, caches, build output
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
dist
build

# evidence bundles: local by design, and they carry captured gate output
.wringer
.wringer.example

# secrets
.env
.env.*

# Historical fixtures and scratch are not needed to build the harness image.
tests
scratch
tmp
*.tmp
*.log

# editor and OS noise
.DS_Store
.idea
.vscode
