+def test_parameter_source_during_convert(runner, option_args, invoke_args, expect):
+    """The source is available to ``ParamType.convert()``.
+
+    Regression test for https://github.com/pallets/click/issues/3458
+    """
+    seen = []
+
+    class Source(click.ParamType):
+        name = "source"
+
+        def convert(self, value, param, ctx):
+            seen.append(ctx.get_parameter_source(param.name))
+            return value
+
+    @click.command()
+    @click.option("-o", "--option", type=Source(), default="1", **option_args)
+    def cli(option):
+        pass
+
+    result = runner.invoke(cli, **invoke_args)
+    assert result.exit_code == 0, result.output
+    assert seen == [expect]
+
+
+def test_parameter_source_during_convert_prompt(runner):
+    """A prompted value is converted twice: once to validate the answer while
+    prompting, and once when the value is processed. The source is only known for the
+    second one, which has been the case since well before
+    https://github.com/pallets/click/issues/3458
+    """
+    seen = []
+
+    class Source(click.ParamType):
+        name = "source"
+
+        def convert(self, value, param, ctx):
+            seen.append(ctx.get_parameter_source(param.name))
+            return value
+
+    @click.command()
+    @click.option("-o", "--option", type=Source(), default="1", prompt=True)
+    def cli(option):
+        pass
+
+    result = runner.invoke(cli, input="2\n")
+    assert result.exit_code == 0, result.output
+    assert seen == [None, ParameterSource.PROMPT]
+
+
+def test_parameter_source_during_callback(runner):
+    """The source is available to a parameter's callback.
+
+    Regression test for https://github.com/pallets/click/issues/3458
+    """
+    seen = []
+
+    def callback(ctx, param, value):
+        seen.append(ctx.get_parameter_source(param.name))
+        return value
+
+    @click.command()
+    @click.option("-o", "--option", default="1", callback=callback)
+    def cli(option):
+        pass
+
+    result = runner.invoke(cli, ["-o", "2"])
+    assert result.exit_code == 0, result.output
+    assert seen == [ParameterSource.COMMANDLINE]
+
+
+@pytest.mark.parametrize("swap", [False, True], ids=["default-first", "envvar-first"])
+def test_parameter_source_during_convert_in_group(runner, swap):
+    """Each option of a group sharing one variable name sees its own incoming source.
+
+    Once parsing is over, the recorded source is the one of the option that won the
+    shared slot, whatever the order the options are declared in.
+
+    Regression tests for https://github.com/pallets/click/issues/3458 and
+    https://github.com/pallets/click/issues/3403
+    """
+    seen = {}
+
+    class Source(click.ParamType):
+        name = "source"
+
+        def convert(self, value, param, ctx):
+            seen[param.opts[0]] = ctx.get_parameter_source(param.name)
+            return value
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx, shared):
+        click.echo(f"{shared} {ctx.get_parameter_source('shared').name}", nl=False)
+
+    decorators = [
+        click.option("--alpha", "shared", type=Source(), default="alpha-default"),
+        click.option("--beta", "shared", type=Source(), envvar="BETA"),
+    ]
+
+    if swap:
+        decorators.reverse()
+
+    for decorator in decorators:
+        cli = decorator(cli)
+
+    result = runner.invoke(cli, env={"BETA": "beta-env"})
+    assert result.exit_code == 0, result.output
+    # ``--alpha`` only has its default to offer, while ``--beta`` picks up the
+    # environment variable and so wins the slot.
+    assert seen == {
+        "--alpha": ParameterSource.DEFAULT,
+        "--beta": ParameterSource.ENVIRONMENT,
+    }
+    assert result.output == "beta-env ENVIRONMENT"
+
+
