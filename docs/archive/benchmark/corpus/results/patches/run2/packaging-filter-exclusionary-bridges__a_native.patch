+    @pytest.mark.parametrize(
+        "specifier",
+        [
+            ">=1,!=1.*,!=2.*,!=3.0,<=3.0",
+            ">=1.0,<=1.5",
+            ">=1.0,<2.0,!=1.5",
+            ">1.0,<=3.0,!=2.0",
+        ],
+    )
+    @pytest.mark.parametrize("prereleases", [None, True, False])
+    def test_specifier_set_filter_matches_contains(self, specifier, prereleases):
+        # Filtering a set of versions must not reject a version that the set
+        # accepts on its own; the presence of other candidates only decides
+        # whether prereleases are held back in favour of final releases.
+        versions = ["0.9", "1.0", "1.5", "1.5a1", "2.0", "3.0", "3.0.dev0", "3.0a1"]
+        spec = SpecifierSet(specifier)
+        kwargs = {"prereleases": prereleases} if prereleases is not None else {}
+
+        filtered = list(spec.filter(versions, **kwargs))
+        contained = [v for v in versions if spec.contains(v, **kwargs)]
+
+        # Everything filter() yields is contained, and filter() only ever drops
+        # a contained version when it is a prerelease shadowed by a final one.
+        assert set(filtered) <= set(contained)
+        assert set(contained) - set(filtered) <= {
+            v for v in contained if Version(v).is_prerelease
+        }
+        if any(not Version(v).is_prerelease for v in contained):
+            assert [v for v in contained if not Version(v).is_prerelease] == [
+                v for v in filtered if not Version(v).is_prerelease
+            ]
+        else:
+            assert filtered == contained
+
