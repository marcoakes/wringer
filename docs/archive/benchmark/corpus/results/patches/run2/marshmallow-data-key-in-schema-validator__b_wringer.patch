+    def _error_key(self, field_name: str) -> str:
+        """Return the key that errors for ``field_name`` are stored under.
+
+        Errors are keyed by ``data_key`` when the field defines one, so that error
+        keys match the keys of the input data.
+        """
+        field_obj = self.fields.get(field_name)
+        if field_obj is None or field_obj.data_key is None:
+            return field_name
+        return field_obj.data_key
+
+    def _resolve_error_keys(self, messages: dict) -> dict:
+        """Replace field names with data keys in the keys of ``messages``."""
+        resolved: dict[str, typing.Any] = {}
+        for field_name, message in messages.items():
+            key = self._error_key(field_name)
+            resolved[key] = (
+                merge_errors(resolved[key], message) if key in resolved else message
+            )
+        return resolved
+
