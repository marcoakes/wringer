index a97bf59..9036d2f 100644
--- a/tests/test_decorators.py
+++ b/tests/test_decorators.py
@@ -649,6 +649,60 @@ class TestValidatesSchemaDecorator:
         errors = MySchema().validate({})
         assert errors["arbitrary_key"] == ["Error message"]
 
+    # https://github.com/marshmallow-code/marshmallow/issues/1258
+    def test_field_errors_are_keyed_by_data_key(self):
+        class MySchema(Schema):
+            ip_addresses = fields.String(data_key="ipAddresses")
+
+            @validates_schema(skip_on_field_errors=False)
+            def validate_with_dict(self, data, **kwargs):
+                raise ValidationError({"ip_addresses": "Dict error."})
+
+            @validates_schema(skip_on_field_errors=False)
+            def validate_with_field_name(self, data, **kwargs):
+                raise ValidationError("Field name error.", field_name="ip_addresses")
+
+            @validates("ip_addresses")
+            def validate_ip_addresses(self, data):
+                raise ValidationError("Field error.")
+
+        errors = MySchema().validate({"ipAddresses": "192.168.0.1"})
+        # All three errors are reported under the same key, regardless of whether
+        # they were raised by a field validator or a schema validator.
+        assert list(errors) == ["ipAddresses"]
+        assert sorted(errors["ipAddresses"]) == [
+            "Dict error.",
+            "Field error.",
+            "Field name error.",
+        ]
+
+    def test_field_errors_are_keyed_by_data_key_many(self):
+        class MySchema(Schema):
+            foo = fields.Int(data_key="fooName")
+
+            @validates_schema
+            def validate_schema(self, data, **kwargs):
+                raise ValidationError("Nope", field_name="foo")
+
+        errors = MySchema().validate([{"fooName": 1}, {"fooName": 2}], many=True)
+        assert errors == {0: {"fooName": ["Nope"]}, 1: {"fooName": ["Nope"]}}
+
+    def test_nested_field_errors_are_keyed_by_data_key(self):
+        class NestedSchema(Schema):
+            baz = fields.Int(data_key="bazName")
+
+        class MySchema(Schema):
+            bar = fields.Nested(NestedSchema, data_key="barName")
+
+            @validates_schema
+            def validate_schema(self, data, **kwargs):
+                raise ValidationError({"bar": {"baz": "Non-matching value"}})
+
+        errors = MySchema().validate({"barName": {"bazName": 5}})
+        # Only the keys of the schema's own fields are resolved. Nested keys are
+        # left untouched, since they belong to the nested schema.
+        assert errors == {"barName": {"baz": "Non-matching value"}}
+
