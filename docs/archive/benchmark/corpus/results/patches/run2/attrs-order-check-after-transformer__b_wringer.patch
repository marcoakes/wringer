+    def test_hook_can_fix_field_order(self):
+        """
+        The hook may reorder fields so that mandatory fields follow defaulted
+        ones, because the order is only checked after it has run.
+
+        Regression test for #1147.
+        """
+
+        def order_by_metadata(cls, attribs):
+            return sorted(attribs, key=lambda a: a.metadata["field_order"])
+
+        @attr.s(auto_attribs=True, field_transformer=order_by_metadata)
+        class C:
+            x: int = attr.ib(metadata={"field_order": 1}, default=0)
+            y: int = attr.ib(metadata={"field_order": 0})
+
+        assert [a.name for a in attr.fields(C)] == ["y", "x"]
+        assert attr.asdict(C(1)) == {"y": 1, "x": 0}
+
+    def test_hook_can_break_field_order(self):
+        """
+        The field order is (re-)checked after the hook has run, so a hook that
+        moves a mandatory field behind a defaulted one is an error.
+        """
+
+        def reverse(cls, attribs):
+            return list(reversed(attribs))
+
+        with pytest.raises(ValueError, match="No mandatory attributes") as ei:
+
+            @attr.s(auto_attribs=True, field_transformer=reverse)
+            class C:
+                y: int
+                x: int = 0
+
+        assert "name='y'" in ei.value.args[0]
+
