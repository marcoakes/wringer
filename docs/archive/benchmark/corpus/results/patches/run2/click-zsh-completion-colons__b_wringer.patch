@@ -354,6 +354,26 @@ def test_full_complete(runner, shell, env, expect):
     assert result.output == expect
 
 
+@pytest.mark.parametrize(
+    ("value", "help", "expect"),
+    [
+        # _describe splits "value:description" on the first unescaped colon,
+        # so colons and backslashes in the value must be escaped.
+        ("baz:quux", "adsf", "plain\nbaz\\:quux\nadsf"),
+        ("back\\slash", "adsf", "plain\nback\\\\slash\nadsf"),
+        ("a:b\\c", "d:e\\f", "plain\na\\:b\\\\c\nd:e\\f"),
+        # Without help the value goes to compadd, which takes it literally.
+        ("baz:quux", None, "plain\nbaz:quux\n_"),
+        ("back\\slash", None, "plain\nback\\slash\n_"),
+    ],
+)
+def test_zsh_escapes_colons_in_values(value, help, expect):
+    comp = click.shell_completion.ZshComplete(
+        Command("cli"), {}, "cli", "_CLI_COMPLETE"
+    )
+    assert comp.format_completion(CompletionItem(value, help=help)) == expect
+
