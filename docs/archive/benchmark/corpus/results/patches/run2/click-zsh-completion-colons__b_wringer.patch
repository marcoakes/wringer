diff --git a/src/click/shell_completion.py b/src/click/shell_completion.py
index 6c39d5e..53485f9 100644
--- a/src/click/shell_completion.py
+++ b/src/click/shell_completion.py
@@ -373,7 +373,16 @@ class ZshComplete(ShellComplete):
         return args, incomplete
 
     def format_completion(self, item: CompletionItem) -> str:
-        return f"{item.type}\n{item.value}\n{item.help if item.help else '_'}"
+        if not item.help:
+            # Values without help are passed to compadd, which takes them
+            # literally, so they must not be escaped.
+            return f"{item.type}\n{item.value}\n_"
+
+        # Values with help are passed to _describe as "value:description"
+        # pairs, where an unescaped colon separates the two and a backslash
+        # escapes the next character.
+        value = item.value.replace("\\", "\\\\").replace(":", "\\:")
+        return f"{item.type}\n{value}\n{item.help}"
 
 
