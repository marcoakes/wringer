--- a/tests/test_unit.py
+++ b/tests/test_unit.py
@@ -2231,6 +2231,74 @@ class Test02_WithoutPackrat(ppt.TestParseResultsAsserts, TestCase):
         self.assertParseAndCheckList(qs, "*///*", ["/"])
         self.assertParseAndCheckList(qs, "*////*", ["//"])
 
+    def testCustomQuotesWithWhitespace(self):
+        # test for Issue #492 - white space embedded in a quote sequence must be
+        # part of the delimiter, not stripped away
+        newline_quote = pp.QuotedString("\n;", multiline=True)
+        print(newline_quote.reString)
+
+        self.assertEqual("\n;", newline_quote.quote_char)
+        self.assertEqual("\n;", newline_quote.end_quote_char)
+
+        # the leading newline is part of the opening quote, so it must not get
+        # skipped over as leading whitespace
+        self.assertNotIn("\n", newline_quote.whiteChars)
+
+        tests = [
+            ("lsjdf \n;Hi \n mum!\n; sldjf", [["Hi \n mum!"]]),
+            ("lsjdf \n;Hi \n m;um!\n; sldjf", [["Hi \n m;um!"]]),
+            ("lsj;df \n;Hi \n m;um!\n; sldjf", [["Hi \n m;um!"]]),
+        ]
+        for test_string, expected in tests:
+            with self.subTest(test_string=test_string):
+                self.assertEqual(
+                    expected, newline_quote.search_string(test_string).as_list()
+                )
+
+        # same, with whitespace skipping disabled entirely
+        with ppt.reset_pyparsing_context():
+            pp.ParserElement.set_default_whitespace_chars("")
+            no_ws_newline_quote = pp.QuotedString("\n;", multiline=True)
+            for test_string, expected in tests:
+                with self.subTest(test_string=test_string, whitespace_chars=""):
+                    self.assertEqual(
+                        expected,
+                        no_ws_newline_quote.search_string(test_string).as_list(),
+                    )
+
+        # a quoted string that is not multiline may not span lines, even though its
+        # quote sequence contains a newline
+        single_line_quote = pp.QuotedString("\n;")
+        print(single_line_quote.reString)
+        self.assertEqual(
+            [["one line"]],
+            single_line_quote.search_string(
+                "a \n;one line\n; b \n;two\nlines\n; c"
+            ).as_list(),
+        )
+
+        # trailing and internal whitespace in the quote sequences is also preserved
+        spaced_quote = pp.QuotedString("<< ", end_quote_char=" >>")
+        print(spaced_quote.reString)
+        self.assertParseAndCheckList(spaced_quote, "<< a b >>", ["a b"])
+        self.assertParseAndCheckList(spaced_quote, "<< a > b >>", ["a > b"])
+
+        # quote sequences must still contain at least one non-whitespace character
+        for kwargs in (
+            {"quote_char": ""},
+            {"quote_char": " "},
+            {"quote_char": "\n"},
+            {"quote_char": " \t\n"},
+            {"quote_char": '"', "end_quote_char": " "},
+            {"quote_char": '"', "end_quote_char": "\n"},
+        ):
+            with self.subTest(**kwargs):
+                with self.assertRaises(
+                    ValueError,
+                    msg=f"failed to raise ValueError for {kwargs}",
+                ):
+                    pp.QuotedString(**kwargs)
+
