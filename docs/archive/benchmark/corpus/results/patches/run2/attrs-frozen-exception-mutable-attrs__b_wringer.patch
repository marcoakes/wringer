+    def test_setting_suppress_context_on_exception(self, decorator):
+        """
+        __suppress_context__ can be set on frozen exceptions, so code that
+        rewrites exception chains can control context suppression.
+        """
+
+        @decorator
+        class MyException(Exception):
+            pass
+
+        with pytest.raises(MyException) as ei:
+            try:
+                raise ValueError
+            except ValueError:
+                raise MyException from None
+
+        assert ei.value.__suppress_context__ is True
+
+        # Un-suppressing it again must work, too.
+        ei.value.__suppress_context__ = False
+
+        assert ei.value.__suppress_context__ is False
+
+    @pytest.mark.parametrize(
+        "decorator",
+        [
+            partial(_attr.s, frozen=True, slots=True, auto_exc=True),
+            attrs.frozen,
+            attrs.define,
+            attrs.mutable,
+        ],
+    )
+    def test_setting_notes_on_exception(self, decorator):
+        """
+        __notes__ can be set on frozen exceptions.
+        """
+
+        @decorator
+        class MyException(Exception):
+            pass
+
+        exc = MyException()
+        exc.__notes__ = ["a note"]
+
+        assert ["a note"] == exc.__notes__
+
