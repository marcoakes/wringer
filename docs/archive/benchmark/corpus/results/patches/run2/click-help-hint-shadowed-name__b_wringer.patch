+        if self.ctx is not None:
+            help_option = self.ctx.command.get_help_option(self.ctx)
+            # Suggest a name the help option actually responds to. A name from
+            # ``help_option_names`` may have been shadowed by one of the
+            # command's own parameters, in which case it is not in ``opts``.
+            if help_option is not None and help_option.opts:
+                hint = _("Try '{command} {option}' for help.").format(
+                    command=self.ctx.command_path, option=help_option.opts[0]
+                )
+                hint = f"{hint}\n"
         if self.ctx is not None:
             color = self.ctx.color
