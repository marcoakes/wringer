+def test_formatting_usage_shadowed_help_name(runner):
+    """The hint must not suggest a help name the command shadowed with one
+    of its own options. See #2790.
+    """
+
+    @click.group(context_settings=dict(help_option_names=["-h", "--help"]))
+    def cli():
+        pass
+
+    @cli.command()
+    @click.argument("arg")
+    @click.option("-h", "--host")
+    def cmd(arg, host):
+        pass
+
+    result = runner.invoke(cli, ["cmd"])
+    assert result.exit_code == 2
+    assert result.output.splitlines() == [
+        "Usage: cli cmd [OPTIONS] ARG",
+        "Try 'cli cmd --help' for help.",
+        "",
+        "Error: Missing argument 'ARG'.",
+    ]
+
+    # The suggested name works.
+    result = runner.invoke(cli, ["cmd", "--help"])
+    assert result.exit_code == 0
+    assert "Usage: cli cmd [OPTIONS] ARG" in result.output
+
+
+def test_formatting_usage_all_help_names_shadowed(runner):
+    @click.command(context_settings=dict(help_option_names=["-h"]))
+    @click.argument("arg")
+    @click.option("-h", "--host")
+    def cmd(arg, host):
+        pass
+
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 2
+    assert result.output.splitlines() == [
+        "Usage: cmd [OPTIONS] ARG",
+        "",
+        "Error: Missing argument 'ARG'.",
+    ]
+
+
+def test_formatting_usage_help_name_order(runner):
+    """The first name in ``help_option_names`` is the one suggested."""
+
+    @click.command(context_settings=dict(help_option_names=["-h", "--help"]))
+    @click.argument("arg")
+    def cmd(arg):
+        pass
+
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 2
+    assert "Try 'cmd -h' for help." in result.output
+
+
