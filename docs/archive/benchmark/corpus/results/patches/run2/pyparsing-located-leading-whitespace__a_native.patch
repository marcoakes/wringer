+    def testLocatedSkipsLeadingWhitespace(self):
+        # Located must report the location of the matched text, not of the whitespace
+        # preceding it, even for expressions that skip whitespace from within their
+        # parseImpl instead of in preParse (Issue #621)
+        abc = pp.Keyword("abc")
+        test_string = "ignored   abc"
+
+        for expr in (
+            abc,
+            abc | abc,
+            abc ^ abc,
+            pp.Each([abc]),
+            pp.MatchFirst([pp.MatchFirst([abc]), abc]),
+        ):
+            with self.subTest(expr=expr):
+                located = pp.Suppress(pp.SkipTo(expr, False)) + pp.Located(expr)
+                res = located.parse_string(test_string)
+                print(res.dump())
+                self.assertParseResultsEquals(
+                    res,
+                    [10, ["abc"], 13],
+                    {"locn_start": 10, "value": ["abc"], "locn_end": 13},
+                )
+                self.assertEqual(
+                    "abc",
+                    test_string[res.locn_start : res.locn_end],
+                    "incorrect location calculation",
+                )
+
+        # ignored expressions are skipped too, and expressions that match leading
+        # whitespace still get a location that includes it
+        located_ignoring_comments = pp.Located(abc | abc).ignore(pp.cpp_style_comment)
+        res = located_ignoring_comments.parse_string(" /*c*/ abc")
+        self.assertParseResultsEquals(res, [7, ["abc"], 10])
+
+        res = pp.Located(pp.White() | abc).parse_string("   abc")
+        self.assertParseResultsEquals(res, [0, ["   "], 3])
+
     def testPop(self):
