@@ -2231,6 +2231,76 @@ class Test02_WithoutPackrat(ppt.TestParseResultsAsserts, TestCase):
         self.assertParseAndCheckList(qs, "*///*", ["/"])
         self.assertParseAndCheckList(qs, "*////*", ["//"])
 
+    def testCustomQuotesWithWhitespace(self):
+        # white space in the quote chars is significant - Issue #492
+        newline_quote = pp.QuotedString("\n;", multiline=True)
+        print(newline_quote.reString)
+
+        self.assertEqual("\n;", newline_quote.quote_char)
+        self.assertEqual("\n;", newline_quote.end_quote_char)
+        self.assertEqual("\n", newline_quote.first_quote_char)
+
+        # the leading newline of the quote char must not get skipped over as
+        # whitespace, whatever the default whitespace chars are
+        for whitespace_chars in (None, "", " \t"):
+            with self.subTest(default_whitespace_chars=whitespace_chars):
+                with ppt.reset_pyparsing_context():
+                    if whitespace_chars is not None:
+                        pp.ParserElement.set_default_whitespace_chars(whitespace_chars)
+                    quoted = pp.QuotedString("\n;", multiline=True)
+
+                    self.assertEqual(
+                        [["Hi \n mum!"]],
+                        quoted.search_string("lsjdf \n;Hi \n mum!\n; sldjf").as_list(),
+                    )
+                    # a lone end quote char is just more quoted content
+                    self.assertEqual(
+                        [["Hi \n m;um!"]],
+                        quoted.search_string("lsjdf \n;Hi \n m;um!\n; sldjf").as_list(),
+                    )
+                    # ... as is a lone end quote char before the opening quote
+                    self.assertEqual(
+                        [["Hi \n m;um!"]],
+                        quoted.search_string(
+                            "lsj;df \n;Hi \n m;um!\n; sldjf"
+                        ).as_list(),
+                    )
+
+        # without multiline, a newline in the quote chars still delimits the
+        # quoted string, but the quoted content stays on one line
+        newline_quote_no_multiline = pp.QuotedString("\n;")
+        print(newline_quote_no_multiline.reString)
+        self.assertParseAndCheckList(
+            newline_quote_no_multiline, "\n;one line;of text\n;", ["one line;of text"]
+        )
+        self.assertEqual(
+            [], newline_quote_no_multiline.search_string("\n;two\nlines\n;").as_list()
+        )
+
+        # tabs in the quote chars require parse_with_tabs, so that the tabs in the
+        # input string don't get expanded to spaces
+        tab_quote = pp.QuotedString("\t*").parse_with_tabs()
+        print(tab_quote.reString)
+        self.assertEqual([["x*y"]], tab_quote.search_string("a  \t*x*y\t* b").as_list())
+
+        # trailing and embedded whitespace is significant too
+        space_quote = pp.QuotedString("# ", end_quote_char=" #")
+        print(space_quote.reString)
+        self.assertParseAndCheckList(space_quote, "# quoted words #", ["quoted words"])
+        self.assertEqual([], space_quote.search_string("#no spaces#").as_list())
+
+        # a quote char that is nothing but whitespace cannot be matched
+        for quote_char_args in (
+            {"quote_char": " "},
+            {"quote_char": "\n\t"},
+            {"quote_char": '"', "end_quote_char": " "},
+        ):
+            with self.subTest(**quote_char_args):
+                with self.assertRaises(
+                    ValueError, msg="failed to raise error for blank quote char"
+                ):
+                    pp.QuotedString(**quote_char_args)
+
