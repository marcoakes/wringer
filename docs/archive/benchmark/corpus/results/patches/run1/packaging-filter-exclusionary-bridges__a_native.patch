+            ("", ["1.0", "2.0a1"]),
+        ],
+    )
+    def test_specifier_filter_matches_contains(self, specifier, input):
+        spec = SpecifierSet(specifier)
+
+        filtered = list(spec.filter(input))
+        contained = [version for version in input if spec.contains(version)]
+
+        # Whatever filter yields must be accepted on its own as well.
+        assert all(spec.contains(version) for version in filtered)
+
+        # When no final release matches the set, the PEP 440 fallback applies
+        # and filter must yield every version that contains() accepts, however
+        # many non-matching versions it is filtered alongside.
+        if all(Version(version).is_prerelease for version in contained):
+            assert filtered == contained
