+    def test_filter_arbitrary_equality_intersection(self):
+        """
+        Test that a set of arbitrary equality specifiers is their intersection.
+
+        Two arbitrary equality specifiers can match different versions, so the
+        set must not collapse them into a single specifier.
+        """
+        versions = ["1.0", "1.0.0"]
+
+        assert list(SpecifierSet("===1.0").filter(versions)) == ["1.0"]
+        assert list(SpecifierSet("===1.0.0").filter(versions)) == ["1.0.0"]
+        assert list(SpecifierSet("===1.0,===1.0.0").filter(versions)) == []
+
+        assert not SpecifierSet("===1.0,===1.0.0").contains("1.0")
+        assert not SpecifierSet("===1.0,===1.0.0").contains("1.0.0")
+
