@@ -322,6 +322,13 @@ class Specifier(BaseSpecifier):
 
     @property
     def _canonical_spec(self) -> tuple[str, str]:
+        # Arbitrary equality matches the version string as-is (ignoring case),
+        # so two such specifiers are only equivalent if their versions are
+        # identical. Canonicalizing here would conflate specifiers that match
+        # different sets of versions, e.g. ===1.0 and ===1.0.0.
+        if self._spec[0] == "===":
+            return self._spec[0], self._spec[1].lower()
+
         canonical_version = canonicalize_version(
             self._spec[1],
             strip_trailing_zero=(self._spec[0] != "~="),
