     def test_specifier_hash_for_compatible_operator(self):
         assert hash(Specifier("~=1.18.0")) != hash(Specifier("~=1.18"))
 
+    def test_specifier_equal_for_arbitrary_operator(self):
+        # Arbitrary equality is not canonicalized, ===1.0 and ===1.0.0 match
+        # different versions, but it does ignore case.
+        assert Specifier("===1.0") != Specifier("===1.0.0")
+        assert Specifier("===1.0") == Specifier("===1.0")
+        assert Specifier("===Lolwat") == Specifier("===lolwat")
+
+    def test_specifier_hash_for_arbitrary_operator(self):
+        assert hash(Specifier("===1.0")) != hash(Specifier("===1.0.0"))
+        assert hash(Specifier("===Lolwat")) == hash(Specifier("===lolwat"))
+
 
