+    def test_hook_can_fix_field_order(self):
+        """
+        The mandatory-after-default check happens *after* the hook ran, so the
+        hook can reorder fields into a valid order.
+
+        Regression test for #1147.
+        """
+
+        def order_by_metadata(cls, attribs):
+            return sorted(attribs, key=lambda a: a.metadata["field_order"])
+
+        @attr.s(auto_attribs=True, field_transformer=order_by_metadata)
+        class C:
+            x: int = attr.ib(metadata={"field_order": 1}, default=0)
+            y: int = attr.ib(metadata={"field_order": 0})
