+    def _load_data_key(self, field_name: str) -> str:
+        """Return the key under which errors for ``field_name`` are stored.
+
+        Errors are keyed by ``data_key`` when the field defines one, so that
+        schema-level validators report errors under the same key as
+        field-level validation.
+        """
+        field_obj = self.load_fields.get(field_name)
+        if field_obj is not None and field_obj.data_key is not None:
+            return field_obj.data_key
+        return field_name
+
+    def _normalize_error_keys(self, messages, field_name: str):
+        """Translate the field names in a schema-level validator's error to data keys."""
+        if field_name != SCHEMA:
+            return messages, self._load_data_key(field_name)
+        if isinstance(messages, dict):
+            normalized: dict[str, typing.Any] = {}
+            for key, value in messages.items():
+                data_key = self._load_data_key(key) if isinstance(key, str) else key
+                if data_key in normalized:
+                    normalized[data_key] = merge_errors(normalized[data_key], value)
+                else:
+                    normalized[data_key] = value
+            return normalized, field_name
+        return messages, field_name
 
