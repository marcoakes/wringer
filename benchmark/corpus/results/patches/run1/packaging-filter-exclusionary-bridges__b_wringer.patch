+    @pytest.mark.parametrize(
+        ("specifier", "input"),
+        [
+            (">=1,!=1.*,!=2.*,!=3.0,<=3.0", ["0.9", "3.0.dev0", "3.0a1", "4.0"]),
+            (">=1.0,<2.0", ["1.5a1", "3.0"]),
+            (">=1.0,<=2.0", ["1.0", "1.5a1"]),
+            (">=1.0,<=2.0dev", ["1.0", "1.5a1"]),
+        ],
+    )
+    def test_specifier_filter_prereleases_are_set_wide(self, specifier, input):
+        # Whether a version is kept must not depend on which other versions
+        # happen to be in the iterable alongside it, beyond the documented
+        # "fall back to prereleases only when no final release matches" rule.
+        # See https://github.com/pypa/packaging/issues/941.
+        spec = SpecifierSet(specifier)
+        filtered = list(spec.filter(input))
+
+        matching = [v for v in input if spec.contains(v, prereleases=True)]
+        finals = [v for v in matching if not Version(v).is_prerelease]
+
+        if spec.prereleases:
+            assert filtered == matching
+        elif finals:
+            assert filtered == finals
+        else:
+            # Nothing but prereleases match the set, so every matching
+            # prerelease is kept -- exactly what a one-item filter call keeps.
+            assert filtered == matching
+            assert filtered == [v for v in input if list(spec.filter([v]))]
+
