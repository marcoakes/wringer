@@ -322,11 +322,16 @@ class Specifier(BaseSpecifier):
 
     @property
     def _canonical_spec(self) -> tuple[str, str]:
+        operator, version = self._spec
+        if operator == "===":
+            return operator, version
+
         canonical_version = canonicalize_version(
