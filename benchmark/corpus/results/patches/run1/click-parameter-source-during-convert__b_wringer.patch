--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -774,6 +774,97 @@ def test_parameter_source(runner, option_args, invoke_args, expect):
     assert rv.return_value == expect
 
 
+@pytest.mark.parametrize(
+    ("option_args", "invoke_args", "expect"),
+    [
+        pytest.param({}, {}, ParameterSource.DEFAULT, id="default"),
+        pytest.param(
+            {},
+            {"default_map": {"option": "1"}},
+            ParameterSource.DEFAULT_MAP,
+            id="default_map",
+        ),
+        pytest.param(
+            {},
+            {"args": ["--option", "1"]},
+            ParameterSource.COMMANDLINE,
+            id="commandline",
+        ),
+        pytest.param(
+            {"envvar": "NAME"},
+            {"env": {"NAME": "1"}},
+            ParameterSource.ENVIRONMENT,
+            id="environment",
+        ),
+    ],
+)
+def test_parameter_source_during_convert(runner, option_args, invoke_args, expect):
+    """The source is recorded before the value is processed, so a custom type can
+    look it up from within ``convert()``.
+
+    https://github.com/pallets/click/issues/3458
+    """
+
+    class Source(click.ParamType):
+        name = "source"
+
+        def convert(self, value, param, ctx):
+            return ctx.get_parameter_source(param.name)
+
+    @click.command()
+    @click.option("--option", type=Source(), default="1", **option_args)
+    def cli(option):
+        return option
+
+    rv = runner.invoke(cli, standalone_mode=False, **invoke_args)
+    assert rv.return_value == expect
+
+
+def test_parameter_source_during_callback(runner):
+    """A parameter callback can also look up the source of the value it receives."""
+
+    def callback(ctx, param, value):
+        return ctx.get_parameter_source(param.name)
+
+    @click.command()
+    @click.option("--option", callback=callback)
+    def cli(option):
+        return option
+
+    rv = runner.invoke(cli, standalone_mode=False)
+    assert rv.return_value == ParameterSource.DEFAULT
+
+    rv = runner.invoke(cli, ["--option", "1"], standalone_mode=False)
+    assert rv.return_value == ParameterSource.COMMANDLINE
+
+
+@pytest.mark.parametrize(
+    ("args", "expect_value", "expect_source"),
+    [
+        pytest.param([], True, ParameterSource.DEFAULT, id="no args"),
+        pytest.param(["--with-xyz"], True, ParameterSource.COMMANDLINE, id="with only"),
+        pytest.param(
+            ["--without-xyz"], False, ParameterSource.COMMANDLINE, id="without only"
+        ),
+    ],
+)
+def test_parameter_source_shared_slot(runner, args, expect_value, expect_source):
+    """When several parameters write the same variable, the source belongs to the
+    one that won the slot, even though each of them publishes its own source while
+    its value is being processed.
+    """
+
+    @click.command()
+    @click.pass_context
+    @click.option("--without-xyz", "xyz", flag_value=False)
+    @click.option("--with-xyz", "xyz", flag_value=True, default=True)
+    def cli(ctx, xyz):
+        return xyz, ctx.get_parameter_source("xyz")
+
+    rv = runner.invoke(cli, args, standalone_mode=False)
+    assert rv.return_value == (expect_value, expect_source)
+
+
