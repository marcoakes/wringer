+def test_formatting_usage_shadowed_help_name(runner):
+    """The hint must only suggest a name the help option really has.
+
+    See: https://github.com/pallets/click/issues/2790
+    """
+
+    @click.group(context_settings={"help_option_names": ["-h", "--help"]})
+    def cmd():
+        pass
+
+    @cmd.command()
+    @click.argument("bar")
+    @click.option("-h", "--host")
+    def foo(bar, host):
+        pass
+
+    result = runner.invoke(cmd, ["foo"])
+    assert result.exit_code == 2
+    assert result.output.splitlines() == [
+        "Usage: cmd foo [OPTIONS] BAR",
+        "Try 'cmd foo --help' for help.",
+        "",
+        "Error: Missing argument 'BAR'.",
+    ]
+
+    # The group does not shadow '-h', so it keeps the preferred name.
+    result = runner.invoke(cmd, ["baz"])
+    assert result.exit_code == 2
+    assert "Try 'cmd -h' for help." in result.output
+
+
+def test_formatting_usage_all_help_names_shadowed(runner):
+    @click.command(context_settings={"help_option_names": ["-h", "--help"]})
+    @click.argument("arg")
+    @click.option("-h", "--help", "help_")
+    def cmd(arg, help_):
+        pass
+
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 2
+    assert result.output.splitlines() == [
+        "Usage: cmd [OPTIONS] ARG",
+        "",
+        "Error: Missing argument 'ARG'.",
+    ]
+
+
+def test_help_option_names_keep_order():
+    """Dropping a shadowed name must not reorder the remaining ones."""
+
+    @click.command()
+    @click.option("--help", "help_")
+    def cmd(help_):
+        pass
+
+    ctx = click.Context(
+        cmd, info_name="cmd", help_option_names=["-h", "--help", "--halp"]
+    )
+    assert cmd.get_help_option_names(ctx) == ["-h", "--halp"]
+    assert cmd.get_help_option(ctx).opts == ["-h", "--halp"]
+
+
