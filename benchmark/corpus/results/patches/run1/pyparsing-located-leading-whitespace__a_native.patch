diff --git a/CHANGES b/CHANGES
index 933395b..bc095fb 100644
--- a/CHANGES
+++ b/CHANGES
@@ -33,6 +33,13 @@ Version 3.3.3 - in development
   `leave_whitespace(recursive=True)`. Issue #633, reported by Ahmed Mohamed Abdelaal,
   PR submitted by fcardosojr18 et AI.
 
+- Fixed bug in `Located`, where the reported `locn_start` included leading whitespace
+  if the wrapped expression was one that skips whitespace internally instead of during
+  pre-parsing (such as `MatchFirst` or `Or`, as created using the `|` and `^`
+  operators). `Located` now does that pre-parsing itself, so that `locn_start` is
+  always the location of the first matched character.
+  Issue #621, reported by fdcds.
+
 - Update type checking to use `mypy 1.20.0`.
 
 - 5-8% performance boost optimizing `ParseResults.copy()`. Inspired by similar changes
diff --git a/pyparsing/core.py b/pyparsing/core.py
index 6e8f389..44aab0a 100644
--- a/pyparsing/core.py
+++ b/pyparsing/core.py
@@ -5583,7 +5583,12 @@ class Located(ParseElementEnhance):
     """
 
     def parseImpl(self, instring, loc, do_actions=True) -> ParseImplReturnType:
-        start = loc
+        # do the wrapped expression's pre-parsing here, so that the reported
+        # start location is the location of the first matched character, and not
+        # of any leading whitespace or ignorables; without this, expressions whose
+        # callPreparse is False (MatchFirst, Or, ...) would skip that whitespace
+        # internally, after start had already been captured
+        start = self.expr.preParse(instring, loc)
         loc, tokens = self.expr._parse(instring, start, do_actions, callPreParse=False)
         ret_tokens = ParseResults([start, tokens, loc])
         ret_tokens["locn_start"] = start
