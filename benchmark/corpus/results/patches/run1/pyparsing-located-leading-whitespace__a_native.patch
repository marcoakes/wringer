+    def testLocatedLeadingWhitespace(self):
+        # Located must not include leading whitespace in locn_start, even when the
+        # wrapped expression skips that whitespace internally instead of during
+        # pre-parsing (as MatchFirst and Or do) - Issue #621
+        test_string = "ignored   abc"
+        abc = pp.Keyword("abc")
+
+        for label, expr in (
+            ("Keyword", abc),
+            ("MatchFirst", abc | abc),
+            ("Or", abc ^ abc),
+            ("And", pp.And([abc])),
+            ("Group", pp.Group(abc | abc)),
+        ):
+            with self.subTest(label):
+                located = pp.Located(expr)
+
+                # standalone
+                result = located.parse_string(test_string[7:])
+                print(label, result.dump())
+                self.assertEqual(
+                    "abc",
+                    test_string[7:][result.locn_start : result.locn_end],
+                    f"incorrect location calculation for {label}",
+                )
+
+                # preceded by another expression in an And, so that Located is
+                # entered at the location of the leading whitespace
+                expr2 = pp.Suppress(pp.SkipTo(located.copy(), include=False)) + located
+                result = expr2.parse_string(test_string)
+                print(label, result.dump())
+                self.assertEqual(
+                    (10, 13),
+                    (result.locn_start, result.locn_end),
+                    f"incorrect location calculation for {label} in And",
+                )
+
+    def testLocatedLeadingWhitespaceWithLeaveWhitespace(self):
+        # Located reports the locations that the wrapped expression actually
+        # matched, so significant leading whitespace must not get skipped
+        abc = pp.Keyword("abc")
+
+        result = pp.Located(pp.White() | abc).parse_string("   abc")
+        print(result.dump())
+        self.assertParseResultsEquals(result, [0, ["   "], 3])
+
+        with self.assertRaisesParseException():
+            pp.Located(abc.copy().leave_whitespace()).parse_string("   abc")
+
+    def testLocatedWithIgnoreExpr(self):
+        # ignored expressions are not part of the match, so they must not be
+        # included in the reported locations
+        abc = pp.Keyword("abc")
+        located = pp.Located(abc | abc).ignore(pp.c_style_comment)
+
+        result = located.parse_string("  /* comment */  abc")
+        print(result.dump())
+        self.assertParseResultsEquals(result, [17, ["abc"], 20])
+
     def testPop(self):
