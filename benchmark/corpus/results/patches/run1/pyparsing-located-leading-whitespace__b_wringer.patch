diff --git a/CHANGES b/CHANGES
index 933395b..17e386f 100644
--- a/CHANGES
+++ b/CHANGES
@@ -29,6 +29,12 @@ Version 3.3.3 - in development
 ------------------------------
 - Adding support for Python 3.15.
 
+- Fixed bug in `Located`, in which the reported `locn_start` included leading
+  whitespace if the contained expression skipped whitespace itself instead of
+  having it skipped by `Located` (as is the case for `MatchFirst` and `Or`
+  expressions, which defer whitespace skipping to their alternatives).
+  Issue #621.
+
 - Fixed matching bug in `match_previous_expr()`, when expression is modified with
   `leave_whitespace(recursive=True)`. Issue #633, reported by Ahmed Mohamed Abdelaal,
   PR submitted by fcardosojr18 et AI.
diff --git a/pyparsing/core.py b/pyparsing/core.py
index 6e8f389..18a82e2 100644
--- a/pyparsing/core.py
+++ b/pyparsing/core.py
@@ -5583,7 +5583,15 @@ class Located(ParseElementEnhance):
     """
 
     def parseImpl(self, instring, loc, do_actions=True) -> ParseImplReturnType:
-        start = loc
+        if self.callPreparse:
+            # leading whitespace and ignorables were already skipped in _parse
+            start = loc
+        else:
+            # this Located does not preParse (as when the contained expression is a
+            # MatchFirst or Or, which leave whitespace skipping to their alternatives),
+            # so skip ahead using the contained expression's whitespace settings, to
+            # keep the reported start location from including leading whitespace
+            start = self.expr.preParse(instring, loc)
         loc, tokens = self.expr._parse(instring, start, do_actions, callPreParse=False)
         ret_tokens = ParseResults([start, tokens, loc])
         ret_tokens["locn_start"] = start
