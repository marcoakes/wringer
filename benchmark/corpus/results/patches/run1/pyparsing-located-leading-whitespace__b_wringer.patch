+    def testLocatedStartLocationSkipsLeadingWhitespace(self):
+        # Located must not include leading whitespace in its reported location,
+        # even when the contained expression does its own whitespace skipping
+        # (as MatchFirst and Or do, deferring to their alternatives)
+        #              0123456789012
+        test_string = "ignored   abc"
+        abc = pp.Keyword("abc")
+
+        for label, expr in (
+            ("Keyword", abc),
+            ("MatchFirst", abc | abc),
+            ("Or", abc ^ abc),
+            ("And", abc + pp.Empty()),
+            ("Group(MatchFirst)", pp.Group(abc | abc)),
+        ):
+            with self.subTest(label):
+                located = pp.Located(expr)
+                result = (pp.Suppress(pp.SkipTo(expr)) + located).parse_string(
+                    test_string
+                )
+                print(label, result.dump())
+                self.assertEqual(
+                    10,
+                    result.locn_start,
+                    f"incorrect locn_start for Located({label})",
+                )
+                self.assertEqual(
+                    13, result.locn_end, f"incorrect locn_end for Located({label})"
+                )
+                self.assertEqual(
+                    "abc", test_string[result.locn_start : result.locn_end]
+                )
+
+                # search_string finds the same span
+                match = located.search_string(test_string)[0]
+                self.assertEqual([10, 13], [match.locn_start, match.locn_end])
+
+    def testLocatedWithLeaveWhitespace(self):
+        # leave_whitespace on a Located expression is still honored
+        expr = pp.Located(pp.Keyword("abc") | pp.Keyword("abc")).leave_whitespace()
+
+        self.assertParseResultsEquals(expr.parse_string("abc"), [0, ["abc"], 3])
+        with self.assertRaisesParseException():
+            expr.parse_string("   abc")
+
     def testPop(self):
