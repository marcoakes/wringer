@@ -368,6 +368,44 @@ def test_email_invalid(invalid_email):
         validator(invalid_email)
 
 
+@pytest.mark.parametrize(
+    "valid_email",
+    [
+        "গিটহাব@তৌহিদুর.বাংলা",
+        "নমস্কার@example.com",
+        "नमस्ते@उदाहरण.भारत",
+        "ทดสอบ@ไทย.th",
+        "இந்தியா@இந்தியா.இந்தியா",
+        "müller@münchen.de",
+        "日本語@例え.jp",
+        "user@xn--mnchen-3ya.de",
+        '"গিটহাব"@example.com',
+    ],
+)
+def test_email_idn_valid(valid_email):
+    validator = validate.Email()
+    assert validator(valid_email) == valid_email
+
+
+@pytest.mark.parametrize(
+    "invalid_email",
+    [
+        # no TLD
+        "গিটহাব@তৌহিদুর",
+        # space in the local part
+        "গিট হাব@তৌহিদুর.বাংলা",
+        # no-break space in the local part
+        "গিটহাব\N{NO-BREAK SPACE}@তৌহিদুর.বাংলা",
+        # leading dot in the local part
+        ".গিটহাব@তৌহিদুর.বাংলা",
+    ],
+)
+def test_email_idn_invalid(invalid_email):
+    validator = validate.Email()
+    with pytest.raises(ValidationError):
+        validator(invalid_email)
+
+
 def test_email_custom_message():
     validator = validate.Email(error="{input} is not an email addy.")
     with pytest.raises(ValidationError, match="invalid is not an email addy."):
