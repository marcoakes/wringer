@@ -373,7 +376,33 @@ class ZshComplete(ShellComplete):
         return args, incomplete
 
     def format_completion(self, item: CompletionItem) -> str:
-        return f"{item.type}\n{item.value}\n{item.help if item.help else '_'}"
+        help_ = item.help if item.help else "_"
+
+        # The completion script feeds items to one of two zsh builtins
+        # depending on whether they have a help text, and the two
+        # disagree about quoting:
+        #
+        # * Items with help go to ``_describe``, which splits each
+        #   "value:description" spec at the first *unescaped* colon, so
+        #   colons belonging to the value must be backslash-escaped.
+        #   Backslashes are unquoted too, so they need escaping as well,
+        #   otherwise a value such as ``a\b`` arrives as ``ab``.
+        # * Items without help go to ``compadd``, which takes the value
+        #   literally and has no notion of escaping, so escaping there
+        #   would insert the backslashes into the command line.
+        #
+        # Escape accordingly, keying off the same "_" sentinel the
+        # completion script uses to tell the two cases apart. The script
+        # is widely deployed already, so it is easier to fix up the data
+        # here than to change the script.
+        #
+        # See issue #1812 and issue #2703 for further context.
+        if help_ != "_":
+            value = item.value.replace("\\", "\\\\").replace(":", "\\:")
+        else:
+            value = item.value
+
+        return f"{item.type}\n{value}\n{help_}"
 
 
