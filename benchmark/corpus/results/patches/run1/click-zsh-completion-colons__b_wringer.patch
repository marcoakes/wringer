+@pytest.mark.parametrize(
+    ("value", "help", "expect"),
+    [
+        # Items with a help text are passed to zsh's `_describe`, which
+        # splits "value:description" at the first unescaped colon, so
+        # colons and backslashes in the value must be escaped.
+        ("baz:quux", "adsf", "plain\nbaz\\:quux\nadsf"),
+        ("a:b:c", "d:e", "plain\na\\:b\\:c\nd:e"),
+        ("back\\slash", "adsf", "plain\nback\\\\slash\nadsf"),
+        ("a\\:b", "adsf", "plain\na\\\\\\:b\nadsf"),
+        # Items without a help text are passed to `compadd`, which takes
+        # the value literally and would insert the backslashes.
+        ("baz:quux", None, "plain\nbaz:quux\n_"),
+        ("back\\slash", None, "plain\nback\\slash\n_"),
+        # Nothing to escape.
+        ("plainvalue", None, "plain\nplainvalue\n_"),
+        ("plainvalue", "adsf", "plain\nplainvalue\nadsf"),
+    ],
+)
+def test_zsh_format_completion_escaping(value, help, expect):
+    cli = Command("cli")
+    comp = click.shell_completion.ZshComplete(cli, {}, cli.name, "_CLI_COMPLETE")
+    assert comp.format_completion(CompletionItem(value, help=help)) == expect
+
+
+@pytest.mark.parametrize(
+    "env",
+    [
+        {"COMP_WORDS": "", "COMP_CWORD": "0"},
+        # A colon in the word being completed must not confuse the
+        # round trip either.
+        {"COMP_WORDS": "baz:", "COMP_CWORD": "0"},
+    ],
+)
+@pytest.mark.usefixtures("_patch_for_completion")
+def test_zsh_full_complete_with_colons(runner, env):
+    """Values containing colons survive the round trip through the zsh
+    completion script. See issue #2703.
+    """
+
+    class Foo(ParamType):
+        def shell_complete(self, ctx, param, incomplete):
+            return [
+                CompletionItem(value="baz:quux", help="adsf"),
+                # No help text, so this one takes the `compadd` path.
+                CompletionItem(value="spam:eggs"),
+            ]
+
+    cli = Command("cli", params=[Argument(["foo"], type=Foo())])
+    env["_CLI_COMPLETE"] = "zsh_complete"
+    result = runner.invoke(cli, env=env)
+    assert result.output == "plain\nbaz\\:quux\nadsf\nplain\nspam:eggs\n_\n"
+
+
