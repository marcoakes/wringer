+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+def test_slots_cached_property_does_not_add_getattr():
+    """
+    Cached properties don't need a __getattr__ that would swallow the
+    AttributeErrors of other descriptors.
+    """
+
+    @attr.s(slots=True)
+    class A:
+        x = attr.ib()
+
+        @functools.cached_property
+        def f(self):
+            return self.x
+
+    assert "__getattr__" not in A.__dict__
+
+
+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+def test_slots_cached_property_propagates_attribute_error(slots):
+    """
+    An AttributeError raised by another descriptor while a cached property is
+    computed keeps its message -- just like on a dict class.
+
+    See #1230.
+    """
+
+    @attr.s(slots=slots)
+    class A:
+        @functools.cached_property
+        def f(self):
+            return self.g
+
+        @property
+        def g(self):
+            raise AttributeError("Message")
+
+    with pytest.raises(AttributeError, match="^Message$"):
+        A().f
+
+
+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+def test_slots_cached_property_raising_attribute_error(slots):
+    """
+    An AttributeError raised by the cached property itself keeps its message.
+    """
+
+    @attr.s(slots=slots)
+    class A:
+        @functools.cached_property
+        def f(self):
+            raise AttributeError("Message")
+
+    with pytest.raises(AttributeError, match="^Message$"):
+        A().f
+
+
+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+def test_slots_cached_property_missing_attribute_names_itself(slots):
+    """
+    A genuinely missing attribute that's accessed by a cached property is
+    reported under its own name.
+    """
+
+    @attr.s(slots=slots)
+    class A:
+        @functools.cached_property
+        def f(self):
+            return self.g
+
+    with pytest.raises(
+        AttributeError, match="'A' object has no attribute 'g'"
+    ):
+        A().f
+
+
+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+def test_slots_cached_property_set_and_delete():
+    """
+    The cached value can be overwritten and deleted, deleting it triggers a
+    recomputation on the next access.
+    """
+    call_count = 0
+
+    @attr.s(slots=True)
+    class A:
+        x = attr.ib()
+
+        @functools.cached_property
+        def f(self):
+            nonlocal call_count
+            call_count += 1
+            return self.x
+
+    obj = A(1)
+
+    obj.f = 42
+    assert 42 == obj.f
+    assert 0 == call_count
+
+    del obj.f
+    assert 1 == obj.f
+    assert 1 == call_count
+
+    del obj.f
+    with pytest.raises(AttributeError):
+        del obj.f
+
+
+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+def test_slots_cached_property_frozen_stays_frozen():
+    """
+    Filling the cache of a cached property doesn't make frozen instances
+    settable.
+    """
+
+    @attrs.frozen
+    class A:
+        x: int
+
+        @functools.cached_property
+        def f(self) -> int:
+            return self.x
+
+    obj = A(1)
+
+    assert 1 == obj.f
+
+    with pytest.raises(attr.exceptions.FrozenInstanceError):
+        obj.f = 2
+
+
