+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+@pytest.mark.parametrize("slots", [True, False])
+def test_cached_property_does_not_swallow_attribute_error(slots):
+    """
+    An AttributeError raised inside an attribute accessed by a cached property
+    is propagated as-is, instead of being replaced by the __getattr__ that is
+    added for cached properties on slotted classes.
+    """
+
+    @attr.s(slots=slots)
+    class A:
+        @functools.cached_property
+        def f(self):
+            return self.g
+
+        @property
+        def g(self):
+            raise AttributeError("Message")
+
+    with pytest.raises(AttributeError, match="^Message$"):
+        A().f
+
+    with pytest.raises(AttributeError, match="^Message$"):
+        A().g
+
+
