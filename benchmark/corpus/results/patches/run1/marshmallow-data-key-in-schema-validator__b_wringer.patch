+    # Regression test for https://github.com/marshmallow-code/marshmallow/issues/2170
+    def test_validator_with_data_key(self):
+        class MySchema(Schema):
+            ip_addresses = fields.String(data_key="ipAddresses")
+
+            @validates_schema
+            def validate_schema(self, data, **kwargs):
+                raise ValidationError("Invalid IP addresses.", "ip_addresses")
+
+        schema = MySchema()
+        assert schema.validate({"ipAddresses": "127.0.0.1"}) == {
+            "ipAddresses": ["Invalid IP addresses."]
+        }
+        assert schema.validate([{"ipAddresses": "127.0.0.1"}], many=True) == {
+            0: {"ipAddresses": ["Invalid IP addresses."]}
+        }
+
+    # Schema- and field-level validators store errors under the same key
+    def test_validator_with_data_key_consistent_with_field_validator(self):
+        class MySchema(Schema):
+            ip_addresses = fields.String(data_key="ipAddresses")
+
+            @validates_schema(skip_on_field_errors=False)
+            def validate_schema(self, data, **kwargs):
+                raise ValidationError("Schema-level error.", "ip_addresses")
+
+            @validates("ip_addresses")
+            def validate_ip_addresses(self, value):
+                raise ValidationError("Field-level error.")
+
+        errors = MySchema().validate({"ipAddresses": "127.0.0.1"})
+        assert errors == {"ipAddresses": ["Field-level error.", "Schema-level error."]}
+
+    def test_validator_with_data_key_on_excluded_field(self):
+        class MySchema(Schema):
+            ip_addresses = fields.String(data_key="ipAddresses")
+            name = fields.String()
+
+            @validates_schema
+            def validate_schema(self, data, **kwargs):
+                raise ValidationError("Invalid IP addresses.", "ip_addresses")
+
+        schema = MySchema(only=("name",))
+        assert schema.validate({"name": "foo"}) == {
+            "ipAddresses": ["Invalid IP addresses."]
+        }
+
+    def test_validator_with_unknown_field_name(self):
+        class MySchema(Schema):
+            foo = fields.String(data_key="fooName")
+
+            @validates_schema
+            def validate_schema(self, data, **kwargs):
+                raise ValidationError("Nope.", "bar")
+
+        assert MySchema().validate({"fooName": "1"}) == {"bar": ["Nope."]}
+
