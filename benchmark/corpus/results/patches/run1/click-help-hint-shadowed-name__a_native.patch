+def test_formatting_usage_shadowed_help_name(runner):
+    """The hint suggests a help name the command actually accepts. See #2790."""
+
+    @click.group(context_settings={"help_option_names": ["-h", "--help"]})
+    def cmd():
+        pass
+
+    @cmd.command()
+    @click.argument("bar")
+    @click.option("-h", "--host")
+    def foo(bar, host):
+        pass
+
+    result = runner.invoke(cmd, ["foo"])
+    assert result.exit_code == 2
+    assert result.output.splitlines() == [
+        "Usage: cmd foo [OPTIONS] BAR",
+        "Try 'cmd foo --help' for help.",
+        "",
+        "Error: Missing argument 'BAR'.",
+    ]
+
+    # The group itself does not shadow '-h', so it keeps suggesting it.
+    result = runner.invoke(cmd, ["bar"])
+    assert result.exit_code == 2
+    assert "Try 'cmd -h' for help." in result.output
+
+
+def test_formatting_usage_all_help_names_shadowed(runner):
+    @click.command(context_settings={"help_option_names": ["-h"]})
+    @click.argument("arg")
+    @click.option("-h", "--host")
+    def cmd(arg, host):
+        pass
+
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 2
+    assert result.output.splitlines() == [
+        "Usage: cmd [OPTIONS] ARG",
+        "",
+        "Error: Missing argument 'ARG'.",
+    ]
+
+
+def test_help_option_names_keep_order(runner):
+    """The remaining names stay in ``help_option_names`` order."""
+
+    @click.command(context_settings={"help_option_names": ["-h", "-?", "--help"]})
+    @click.option("-h", "--host")
+    def cmd(host):
+        pass
+
+    ctx = click.Context(cmd, help_option_names=["-h", "-?", "--help"])
+    assert cmd.get_help_option_names(ctx) == ["-?", "--help"]
+
+    result = runner.invoke(cmd, ["-?"])
+    assert result.exit_code == 0
+    assert "-?, --help" in result.output
+
+
