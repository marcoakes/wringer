     def format_completion(self, item: CompletionItem) -> str:
-        return f"{item.type}\n{item.value}\n{item.help if item.help else '_'}"
+        help_ = item.help if item.help else "_"
+        # The zsh script passes items that have a help text to
+        # `_describe`, which splits "value:description" pairs at the
+        # first unescaped colon, so colons in the value must be escaped.
+        # Items without a help text go to `compadd`, which uses the
+        # value verbatim and does not unescape colons, so escaping there
+        # would insert literal backslashes. Therefore escape only when
+        # the help text is not the "_" sentinel used by the script.
+        #
+        # Doing this here rather than in the script means already
+        # generated and deployed scripts get the fix too.
+        #
+        # See issue #1812 and issue #2703.
+        value = item.value.replace(":", r"\:") if help_ != "_" else item.value
+        return f"{item.type}\n{value}\n{help_}"
 
 
