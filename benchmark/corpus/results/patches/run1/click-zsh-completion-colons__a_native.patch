+@pytest.mark.parametrize(
+    ("value", "help_text", "expect"),
+    [
+        # Items with a help text go through `_describe`, which splits at
+        # the first unescaped colon, so colons in the value are escaped.
+        # Colons in the help text itself need no escaping.
+        ("baz:quux", "adsf", "plain\nbaz\\:quux\nadsf"),
+        ("a:b:c", "d:e", "plain\na\\:b\\:c\nd:e"),
+        ("nocolon", "adsf", "plain\nnocolon\nadsf"),
+        # Items without a help text go through `compadd`, which does not
+        # unescape colons, so the value is passed through untouched.
+        ("baz:quux", None, "plain\nbaz:quux\n_"),
+        ("baz:quux", "", "plain\nbaz:quux\n_"),
+    ],
+)
+def test_zsh_format_completion_escapes_colons(value, help_text, expect):
+    """Colons are escaped only on the `_describe` code path. See issue #2703."""
+    comp = click.shell_completion.ZshComplete(
+        Command("cli"), {}, "cli", "_CLI_COMPLETE"
+    )
+    assert comp.format_completion(CompletionItem(value, help=help_text)) == expect
+
+
+@pytest.mark.usefixtures("_patch_for_completion")
+def test_zsh_full_complete_with_colons(runner):
+    """Completions containing colons survive the round trip. See issue #2703."""
+    cli = Group(
+        "cli",
+        commands=[
+            Command("c:d", help="cee:dee"),
+            Command("c:e"),
+        ],
+    )
+    result = runner.invoke(
+        cli,
+        env={
+            "COMP_WORDS": "c:",
+            "COMP_CWORD": "0",
+            "_CLI_COMPLETE": "zsh_complete",
+        },
+    )
+    assert result.output == "plain\nc\\:d\ncee:dee\nplain\nc:e\n_\n"
+
+
