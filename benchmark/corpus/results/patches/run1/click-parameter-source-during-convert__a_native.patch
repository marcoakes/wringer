+            ParameterSource.DEFAULT_MAP,
+            id="default map",
+        ),
+        pytest.param(
+            {},
+            {"args": ["-o", "1"]},
+            ParameterSource.COMMANDLINE,
+            id="commandline",
+        ),
+        pytest.param(
+            {"envvar": "NAME"},
+            {"env": {"NAME": "1"}},
+            ParameterSource.ENVIRONMENT,
+            id="environment",
+        ),
+    ],
+)
+def test_parameter_source_during_convert(runner, option_args, invoke_args, expect):
+    """The source is available to ``ParamType.convert()``.
+
+    Regression test for https://github.com/pallets/click/issues/3458
+    """
+
+    class Source(click.ParamType):
+        name = "source"
+
+        def convert(self, value, param, ctx):
+            return ctx.get_parameter_source(param.name)
+
+    @click.command()
+    @click.option("-o", "--option", type=Source(), default="1", **option_args)
+    def cli(option):
+        return option
+
+    rv = runner.invoke(cli, standalone_mode=False, **invoke_args)
+    assert rv.return_value == expect
+
+
+def test_parameter_source_during_callback(runner):
+    """The source is available to a parameter's callback.
+
+    Regression test for https://github.com/pallets/click/issues/3458
+    """
+
+    @click.command()
+    @click.option(
+        "-o",
+        "--option",
+        default="1",
+        callback=lambda ctx, param, value: ctx.get_parameter_source(param.name),
+    )
+    def cli(option):
+        return option
+
+    rv = runner.invoke(cli, ["-o", "2"], standalone_mode=False)
+    assert rv.return_value == ParameterSource.COMMANDLINE
+
+
+def test_parameter_source_group_loser_does_not_leak(runner):
+    """A losing member of a feature-switch group must not overwrite the source.
+
+    The source is published before conversion so ``convert()`` can see it, but the
+    parameter that owns the value is the one whose source is visible afterwards.
+
+    Refs https://github.com/pallets/click/issues/3403 and
+    https://github.com/pallets/click/issues/3458
+    """
+    seen = []
+
+    class Source(click.ParamType):
+        name = "source"
+
+        def convert(self, value, param, ctx):
+            seen.append((param.opts[0], ctx.get_parameter_source(param.name)))
+            return value
+
+    @click.command()
+    @click.pass_context
+    @click.option(
+        "--with-xyz", "enable_xyz", type=Source(), flag_value="on", envvar="XYZ"
+    )
+    @click.option("--without-xyz", "enable_xyz", type=Source(), flag_value="off")
+    def cli(ctx, enable_xyz):
+        return enable_xyz, ctx.get_parameter_source("enable_xyz")
+
+    rv = runner.invoke(cli, standalone_mode=False, env={"XYZ": "on"})
+    # ``--with-xyz`` wins the slot from the environment. ``--without-xyz`` is processed
+    # afterwards with a DEFAULT source, which must not clobber the winner's source.
+    assert rv.return_value == ("on", ParameterSource.ENVIRONMENT)
+    assert seen == [("--with-xyz", ParameterSource.ENVIRONMENT)]
+
+
