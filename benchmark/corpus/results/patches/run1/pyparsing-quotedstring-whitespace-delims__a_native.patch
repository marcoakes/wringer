@@ -2231,6 +2231,64 @@ class Test02_WithoutPackrat(ppt.TestParseResultsAsserts, TestCase):
         self.assertParseAndCheckList(qs, "*///*", ["/"])
         self.assertParseAndCheckList(qs, "*////*", ["//"])
 
+    def testCustomQuotesWithWhitespace(self):
+        # test for Issue #492 - white space in the quote characters is part of the
+        # quote delimiters, and is not stripped away
+        newline_quote = pp.QuotedString("\n;", multiline=True)
+        print(newline_quote.pattern)
+        self.assertEqual("\n;", newline_quote.quote_char)
+        self.assertEqual("\n;", newline_quote.end_quote_char)
+
+        tests = [
+            ("lsjdf \n;Hi \n mum!\n; sldjf", [["Hi \n mum!"]]),
+            ("lsjdf \n;Hi \n m;um!\n; sldjf", [["Hi \n m;um!"]]),
+            ("lsj;df \n;Hi \n m;um!\n; sldjf", [["Hi \n m;um!"]]),
+        ]
+        for test_string, expected in tests:
+            # the leading newline of the quote is not skipped over as whitespace,
+            # whether or not "\n" is in the default whitespace characters
+            with self.subTest(test_string=test_string):
+                self.assertEqual(
+                    expected, newline_quote.search_string(test_string).as_list()
+                )
+
+            with self.subTest(test_string=test_string, default_whitespace_chars=""):
+                with ppt.reset_pyparsing_context():
+                    pp.ParserElement.set_default_whitespace_chars("")
+                    no_ws_quote = pp.QuotedString("\n;", multiline=True)
+                    self.assertEqual(
+                        expected, no_ws_quote.search_string(test_string).as_list()
+                    )
+
+        with self.subTest("quote containing a newline, without multiline=True"):
+            single_line_quote = pp.QuotedString("\n;")
+            print(single_line_quote.pattern)
+            found = single_line_quote.search_string("lsjdf \n;Hi mum!\n; sldjf")
+            self.assertEqual([["Hi mum!"]], found.as_list())
+            # the quoted content may not span lines
+            found = single_line_quote.search_string("lsjdf \n;Hi \n mum!\n; sldjf")
+            self.assertEqual([], found.as_list())
+
+        with self.subTest("quote characters padded with spaces"):
+            padded_quote = pp.QuotedString(quote_char="[ ", end_quote_char=" ]")
+            print(padded_quote.pattern)
+            self.assertParseAndCheckList(padded_quote, "[ Hi mum! ]", ["Hi mum!"])
+            with self.assertRaisesParseException():
+                padded_quote.parse_string("[Hi mum!]")
+
+        with self.subTest("quote characters containing a tab"):
+            # tabs get expanded to spaces unless parse_with_tabs() is called
+            tab_quote = pp.QuotedString("\t|", multiline=True).parse_with_tabs()
+            found = tab_quote.search_string("a\t|Hi \n mum!\t|b")
+            self.assertEqual([["Hi \n mum!"]], found.as_list())
+
+        with self.subTest("all-whitespace quote characters are still invalid"):
+            for bad_quote_char in ("", " ", "\n", " \t\n"):
+                with self.assertRaises(ValueError):
+                    pp.QuotedString(bad_quote_char)
+                with self.assertRaises(ValueError):
+                    pp.QuotedString("'", end_quote_char=bad_quote_char)
+
