     return version
 
 
+def _filter_versions(
+    iterable: Iterable[UnparsedVersionVar],
+    matches: Callable[[Version], bool],
+    prereleases: bool | None,
+) -> Iterator[UnparsedVersionVar]:
+    """Yield the items of ``iterable`` accepted by ``matches``.
+
+    ``prereleases`` is a tri-state: ``True`` yields prereleases along with
+    everything else, ``False`` drops them, and ``None`` follows the
+    recommendation from :pep:`440` and only yields them if nothing else
+    matched.
+
+    The ``None`` case is why this takes a single ``matches`` callable covering
+    every specifier at once: whether a prerelease is yielded depends on what
+    else matched *all* of the specifiers, so the decision cannot be made one
+    specifier at a time.
+    """
+    prereleases_versions = []
+    found_non_prereleases = False
+
+    for version in iterable:
+        parsed_version = _coerce_version(version)
+
+        if not matches(parsed_version):
+            continue
+
+        # If it's not a prerelease or prereleases are allowed, yield it directly
+        if not parsed_version.is_prerelease or prereleases:
+            found_non_prereleases = True
+            yield version
+        # Otherwise collect prereleases for potential later use
+        elif prereleases is None and not found_non_prereleases:
+            prereleases_versions.append(version)
+
+    # If we've found no items except for prereleases, then we'll go ahead and
+    # use the prereleases
+    if not found_non_prereleases and prereleases is None:
+        yield from prereleases_versions
+
+
