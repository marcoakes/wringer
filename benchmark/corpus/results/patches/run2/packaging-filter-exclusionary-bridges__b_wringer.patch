+    def test_specifier_filter_does_not_depend_on_specifier_order(self):
+        # The specifiers are held in a frozenset, so their iteration order
+        # varies with the hash seed. Filtering must not depend on it.
+        spec = SpecifierSet(">=1,!=1.*,!=2.*,!=3.0,<=3.0")
+        versions = ["0.9", "3.0.dev0", "3.0a1", "4.0"]
+
+        assert list(spec.filter(versions)) == ["3.0.dev0", "3.0a1"]
+        # Every kept version is one the set contains on its own, and no
+        # dropped version was kept only because of what it was filtered with.
+        for version in versions:
+            assert spec.contains(version) == (version in ["3.0.dev0", "3.0a1"])
+
+    def test_specifier_filter_honours_explicitly_disallowed_prereleases(self):
+        # ``prereleases=False`` on a member specifier rules out the fallback
+        # for the set as a whole.
+        spec = SpecifierSet([Specifier(">=1"), Specifier("<2", prereleases=False)])
+
+        assert list(spec.filter(["1.5a1"])) == []
+        assert list(spec.filter(["1.5a1"], prereleases=True)) == ["1.5a1"]
+
