+    def test_hook_can_fix_field_order(self):
+        """
+        The hook can reorder fields such that mandatory fields come before
+        fields with defaults -- the check for that happens after the hook ran.
+
+        Regression test for #1147.
+        """
+
+        def order_by_metadata(cls, attribs):
+            return sorted(attribs, key=lambda a: a.metadata["field_order"])
+
+        @attrs.define(field_transformer=order_by_metadata)
+        class C:
+            x: int = attrs.field(metadata={"field_order": 1}, default=0)
+            y: int = attrs.field(metadata={"field_order": 0})
+
+        assert [a.name for a in attrs.fields(C)] == ["y", "x"]
+        assert C(42) == C(y=42, x=0)
+
+    def test_hook_can_break_field_order(self):
+        """
+        If the hook reorders fields such that a mandatory field ends up after
+        one with a default, the order check fails.
+        """
+
+        def reverse(cls, attribs):
+            return list(reversed(attribs))
+
+        with pytest.raises(ValueError, match="No mandatory attributes"):
+
+            @attrs.define(field_transformer=reverse)
+            class C:
+                x: int
+                y: int = 0
