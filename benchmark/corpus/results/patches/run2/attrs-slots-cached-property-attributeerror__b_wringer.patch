+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+def test_slots_cached_property_raising_attribute_error():
+    """
+    Ensures error information is not lost when a cached_property raises an
+    AttributeError itself.
+    """
+
+    @attr.s(slots=True)
+    class A:
+        x = attr.ib()
+
+        @functools.cached_property
+        def f(self):
+            raise AttributeError("Big Problem")
+
+    a = A(1)
+    with pytest.raises(AttributeError, match="Big Problem"):
+        a.f
+
+
+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+def test_slots_cached_property_propagating_attribute_error_from_property():
+    """
+    An AttributeError raised by a property that a cached_property depends on
+    keeps its message, instead of being replaced by the __getattr__ fallback's
+    generic "no attribute" error.
+
+    Regression test for #1230.
+    """
+
+    @attr.s(slots=True)
+    class A:
+        @functools.cached_property
+        def x(self):
+            return self.y
+
+        @property
+        def y(self):
+            raise AttributeError("Message")
+
+    a = A()
+
+    with pytest.raises(AttributeError, match="Message"):
+        a.x
+
+    # Also when accessed directly -- the __getattr__ that attrs adds for the
+    # cached property must not swallow it either.
+    with pytest.raises(AttributeError, match="Message"):
+        a.y
+
+
