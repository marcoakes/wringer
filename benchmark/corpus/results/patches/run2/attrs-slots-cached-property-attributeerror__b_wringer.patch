diff --git a/changelog.d/1230.change.md b/changelog.d/1230.change.md
new file mode 100644
index 0000000..e2e536a
--- /dev/null
+++ b/changelog.d/1230.change.md
@@ -0,0 +1 @@
+On slotted classes with `functools.cached_property`s, an `AttributeError` raised by a property (or any other descriptor) is no longer replaced by a generic `'C' object has no attribute 'x'` error from the `__getattr__` that *attrs* adds to support cached properties.
diff --git a/src/attr/_make.py b/src/attr/_make.py
index 0114582..aa6c6c4 100644
--- a/src/attr/_make.py
+++ b/src/attr/_make.py
@@ -619,10 +619,18 @@ def _make_cached_property_getattr(cached_properties, original_getattr, cls):
     else:
         lines.extend(
             [
-                "         if hasattr(super(), '__getattr__'):",
-                "              return super().__getattr__(item)",
-                "         original_error = f\"'{self.__class__.__name__}' object has no attribute '{item}'\"",
-                "         raise AttributeError(original_error)",
+                # Retry the lookup instead of raising a fresh AttributeError.
+                # Since we're the fallback for *every* failed attribute access
+                # on this class -- not just cached properties -- swallowing the
+                # error here would hide, for example, an AttributeError raised
+                # by a property's own body. Note that object.__getattribute__
+                # does not consult __getattr__, so this doesn't recurse.
+                "         try:",
+                "             return super().__getattribute__(item)",
+                "         except AttributeError:",
+                "             if not hasattr(super(), '__getattr__'):",
+                "                 raise",
+                "             return super().__getattr__(item)",
             ]
         )
 
