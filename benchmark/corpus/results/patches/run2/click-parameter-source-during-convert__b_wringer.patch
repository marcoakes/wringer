index e35c532..8149955 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -774,6 +774,80 @@ def test_parameter_source(runner, option_args, invoke_args, expect):
     assert rv.return_value == expect
 
 
+@pytest.mark.parametrize(
+    ("invoke_args", "expect"),
+    [
+        pytest.param({}, ParameterSource.DEFAULT, id="default"),
+        pytest.param({"args": ["-o", "1"]}, ParameterSource.COMMANDLINE, id="cli"),
+        pytest.param(
+            {"default_map": {"option": "1"}}, ParameterSource.DEFAULT_MAP, id="map"
+        ),
+        pytest.param(
+            {"envvar": "NAME", "env": {"NAME": "1"}},
+            ParameterSource.ENVIRONMENT,
+            id="envvar",
+        ),
+    ],
+)
+def test_parameter_source_during_convert(runner, invoke_args, expect):
+    """The source is available while the value is being converted by the type.
+
+    https://github.com/pallets/click/issues/3458
+    """
+    envvar = invoke_args.pop("envvar", None)
+
+    class Source(click.ParamType):
+        name = "source"
+
+        def convert(self, value, param, ctx):
+            return ctx.get_parameter_source(param.name)
+
+    @click.command()
+    @click.option("-o", "--option", type=Source(), default="1", envvar=envvar)
+    def cli(option):
+        return option
+
+    rv = runner.invoke(cli, standalone_mode=False, **invoke_args)
+    assert rv.return_value == expect
+
+
+def test_parameter_source_during_callback(runner):
+    """The source is also available to a parameter's callback."""
+
+    def callback(ctx, param, value):
+        return value, ctx.get_parameter_source(param.name)
+
+    @click.command()
+    @click.option("-o", "--option", default=1, callback=callback)
+    def cli(option):
+        return option
+
+    assert runner.invoke(cli, standalone_mode=False).return_value == (
+        1,
+        ParameterSource.DEFAULT,
+    )
+    rv = runner.invoke(cli, args=["-o", "2"], standalone_mode=False)
+    assert rv.return_value == (2, ParameterSource.COMMANDLINE)
+
+
+def test_parameter_source_feature_switch_group_not_clobbered(runner):
+    """The provisional source set before conversion must not overwrite the source
+    of the parameter that actually owns the shared slot."""
+
+    @click.command()
+    @click.option("--upper", "transform", flag_value="upper", default=True)
+    @click.option("--lower", "transform", flag_value="lower")
+    @click.pass_context
+    def cli(ctx, transform):
+        return transform, ctx.get_parameter_source("transform")
+
+    rv = runner.invoke(cli, args=["--lower"], standalone_mode=False)
+    assert rv.return_value == ("lower", ParameterSource.COMMANDLINE)
+
+    rv = runner.invoke(cli, standalone_mode=False)
+    assert rv.return_value == ("upper", ParameterSource.DEFAULT)
+
+
