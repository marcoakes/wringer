+    @pytest.mark.parametrize(
+        "decorator",
+        [
+            partial(_attr.s, frozen=True, slots=True, auto_exc=True),
+            attrs.frozen,
+            attrs.define,
+            attrs.mutable,
+        ],
+    )
+    def test_add_note_on_exception(self, decorator):
+        """
+        BaseException.add_note() mutates __notes__ and therefore works on
+        frozen exceptions, too.
+        """
+
+        @decorator
+        class MyException(Exception):
+            pass
+
+        exc = MyException()
+        exc.add_note("note 1")
+        exc.add_note("note 2")
+
+        assert ["note 1", "note 2"] == exc.__notes__
+
+        # Setting it wholesale works, too.
+        exc.__notes__ = ["note 3"]
+
+        assert ["note 3"] == exc.__notes__
+
+    @pytest.mark.parametrize(
