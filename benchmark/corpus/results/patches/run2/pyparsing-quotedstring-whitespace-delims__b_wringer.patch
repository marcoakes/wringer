--- a/tests/test_unit.py
+++ b/tests/test_unit.py
@@ -2209,6 +2209,69 @@ class Test02_WithoutPackrat(ppt.TestParseResultsAsserts, TestCase):
         with self.assertRaises(ValueError):
             pp.QuotedString("", "\\")
 
+    def testCustomQuotesWithWhitespace(self):
+        # test for Issue #492 - white space in the quote string was silently
+        # stripped away, so "\n;" behaved just like ";"
+        qs = pp.QuotedString("\n;", multiline=True)
+        print(qs.pattern)
+
+        self.assertEqual("\n;", qs.quote_char)
+        self.assertEqual("\n;", qs.end_quote_char)
+
+        # the leading newline of the quote string must not be skipped over as
+        # whitespace, but the other default whitespace chars still are
+        self.assertNotIn("\n", qs.whiteChars)
+        self.assertIn(" ", qs.whiteChars)
+        self.assertNotIn("\n", qs.copy().whiteChars)
+
+        self.assertEqual(
+            [["Hi \n mum!"]],
+            qs.search_string("lsjdf \n;Hi \n mum!\n; sldjf").as_list(),
+        )
+        # the end quote char is only a delimiter when preceded by a newline
+        self.assertEqual(
+            [["Hi \n m;um!"]],
+            qs.search_string("lsjdf \n;Hi \n m;um!\n; sldjf").as_list(),
+        )
+        # a ';' ahead of the opening quote is not an opening quote
+        self.assertEqual(
+            [["Hi \n m;um!"]],
+            qs.search_string("lsj;df \n;Hi \n m;um!\n; sldjf").as_list(),
+        )
+
+        # same expression, with whitespace skipping fully disabled by the caller
+        with ppt.reset_pyparsing_context():
+            pp.ParserElement.set_default_whitespace_chars("")
+            qs = pp.QuotedString("\n;", multiline=True)
+            self.assertEqual(
+                [["Hi \n m;um!"]],
+                qs.search_string("lsj;df \n;Hi \n m;um!\n; sldjf").as_list(),
+            )
+
+        # without multiline, the quoted body cannot contain a line end, even
+        # though the quote strings themselves do
+        qs = pp.QuotedString("\n;")
+        print(qs.pattern)
+        self.assertEqual(
+            [], qs.search_string("lsjdf \n;Hi \n mum!\n; sldjf").as_list()
+        )
+        self.assertEqual(
+            [["one; line"]],
+            qs.search_string("lsjdf \n;one; line\n; sldjf").as_list(),
+        )
+
+        # trailing whitespace in the quote string is significant too
+        qs = pp.QuotedString("<< ", end_quote_char=" >>")
+        self.assertParseAndCheckList(qs, "<< abc >>", ["abc"])
+        with self.assertRaisesParseException():
+            qs.parse_string("<<abc>>")
+
+        # quote chars that are nothing but whitespace can never match
+        with self.assertRaises(ValueError):
+            pp.QuotedString(" \t\n")
+        with self.assertRaises(ValueError):
+            pp.QuotedString('"', end_quote_char=" ")
+
