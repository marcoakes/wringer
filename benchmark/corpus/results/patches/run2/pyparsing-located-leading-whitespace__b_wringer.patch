+    def testLocatedWithLeadingWhitespace(self):
+        # Located must report the location where the contained expression starts
+        # matching, and not include any leading whitespace - even if the contained
+        # expression is one that leaves pre-parsing to its own contained expressions,
+        # such as MatchFirst or Or. (Issue #621)
+        abc = pp.Keyword("abc")
+
+        #              0123456789012
+        test_string = "ignored   abc"
+
+        contained_exprs = [
+            ("Keyword", abc),
+            ("MatchFirst", abc | abc),
+            ("Or", abc ^ abc),
+            ("And", abc + pp.Empty()),
+            ("Forward", pp.Forward() << (abc | abc)),
+        ]
+        preceding_exprs = [
+            ("Literal", lambda contained_expr: pp.Literal("ignored")),
+            ("SkipTo", lambda contained_expr: pp.SkipTo(contained_expr, False)),
+        ]
+        for expr_name, contained_expr in contained_exprs:
+            for preceding_name, make_preceding_expr in preceding_exprs:
+                with self.subTest(contained_expr=expr_name, preceded_by=preceding_name):
+                    located = pp.Located(contained_expr)
+                    expr = pp.Suppress(make_preceding_expr(contained_expr)) + located
+                    result = expr.parse_string(test_string)
+                    print(result.dump())
+                    self.assertParseResultsEquals(
+                        result,
+                        [10, ["abc"], 13],
+                        {"locn_start": 10, "locn_end": 13, "value": ["abc"]},
+                    )
+                    self.assertEqual(
+                        "abc",
+                        test_string[result.locn_start : result.locn_end],
+                        "incorrect location calculation",
+                    )
+
+        # Located as the leading expression of an And must also skip leading whitespace
+        result = (pp.Located(abc | abc) + pp.StringEnd()).parse_string("   abc")
+        self.assertParseResultsEquals(result, [3, ["abc"], 6])
+
+        # but if the contained expression leaves whitespace, so must Located
+        leading_ws_not_skipped = pp.Located(
+            (abc | abc).leave_whitespace(recursive=True)
+        )
+        with self.assertRaisesParseException():
+            leading_ws_not_skipped.parse_string("   abc")
+
     def testPop(self):
         source = "AAA 123 456 789 234"
         patt = pp.Word(pp.alphas)("name") + pp.Word(pp.nums) * (1,)
