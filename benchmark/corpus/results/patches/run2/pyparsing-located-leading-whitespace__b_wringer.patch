diff --git a/pyparsing/core.py b/pyparsing/core.py
index 6e8f389..d594b9b 100644
--- a/pyparsing/core.py
+++ b/pyparsing/core.py
@@ -5582,6 +5582,16 @@ class Located(ParseElementEnhance):
         [18, ['lkkjj'], 23]
     """
 
+    def __init__(self, expr: Union[ParserElement, str]) -> None:
+        super().__init__(expr)
+        # parseImpl parses the contained expression with callPreParse=False, taking
+        # responsibility for pre-parsing itself so that it can capture the location
+        # where the match actually starts. So Located must always pre-parse, even if
+        # the contained expression would not have (as is the case for ParseExpressions
+        # such as MatchFirst and Or, which leave pre-parsing to their alternatives);
+        # otherwise the reported start location would include the leading whitespace.
+        self.callPreparse = True
+
     def parseImpl(self, instring, loc, do_actions=True) -> ParseImplReturnType:
         start = loc
         loc, tokens = self.expr._parse(instring, start, do_actions, callPreParse=False)
