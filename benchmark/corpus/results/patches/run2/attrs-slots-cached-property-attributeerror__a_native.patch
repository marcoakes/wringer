+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+def test_slots_cached_property_raising_attributeerror():
+    """
+    Ensures AttributeError raised by a property is preserved, instead of being
+    replaced by a AttributeError about a missing attribute.
+
+    Regression test for #1230
+    """
+
+    @attr.s(slots=True)
+    class A:
+        x = attr.ib()
+
+        @functools.cached_property
+        def f(self):
+            return self.p
+
+        @property
+        def p(self):
+            raise AttributeError("Attribute error inside property")
+
+    a = A(1)
+
+    with pytest.raises(
+        AttributeError, match="Attribute error inside property"
+    ):
+        a.p
+
+    with pytest.raises(
+        AttributeError, match="Attribute error inside property"
+    ):
+        a.f
+
+    with pytest.raises(
+        AttributeError, match="'A' object has no attribute 'z'"
+    ):
+        a.z
+
+
+@pytest.mark.skipif(not PY_3_8_PLUS, reason="cached_property is 3.8+")
+def test_slots_cached_property_raising_attributeerror_with_getattr():
+    """
+    A user-defined `__getattr__` still gets the chance to handle the
+    AttributeError raised by a property -- exactly like on a dict class.
+    """
+
+    @attr.s(slots=True)
+    class A:
+        x = attr.ib()
+
+        @functools.cached_property
+        def f(self):
+            return self.p
+
+        @property
+        def p(self):
+            raise AttributeError("Attribute error inside property")
+
+        def __getattr__(self, item):
+            return item
+
+    a = A(1)
+
+    assert "z" == a.z
+    assert "p" == a.p
+    assert "p" == a.f
+
+
