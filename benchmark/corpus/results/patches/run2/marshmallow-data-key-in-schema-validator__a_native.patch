         data = self.opts.render_module.loads(json_data, **kwargs)
         return self.load(data, many=many, partial=partial, unknown=unknown)
 
+    def _error_key(self, field_name):
+        """Return the key that errors for ``field_name`` should be stored under.
+
+        Field names are translated to their ``data_key`` so that errors raised by
+        schema-level validators are keyed like field-level errors. Names that don't
+        belong to a load field -- `SCHEMA <marshmallow.exceptions.SCHEMA>`, a
+        ``data_key`` passed directly, or an arbitrary key -- pass through unchanged.
+        """
+        field_obj = self.load_fields.get(field_name)
+        if field_obj is None or field_obj.data_key is None:
+            return field_name
+        return field_obj.data_key
+
     def _run_validator(
         self,
         validator_func,
@@ -840,7 +853,23 @@ class Schema(base.SchemaABC, metaclass=SchemaMeta):
             else:
                 validator_func(output, partial=partial, many=many)
         except ValidationError as err:
-            error_store.store_error(err.messages, err.field_name, index=index)
+            if err.field_name != SCHEMA:
+                error_store.store_error(
+                    err.messages, self._error_key(err.field_name), index=index
+                )
+            elif isinstance(err.messages, dict):
+                # Top-level keys name fields, so translate them to their data_key.
+                messages = {}
+                for key, value in err.messages.items():
+                    error_key = self._error_key(key)
+                    messages[error_key] = (
+                        merge_errors(messages[error_key], value)
+                        if error_key in messages
+                        else value
+                    )
+                error_store.store_error(messages, index=index)
+            else:
+                error_store.store_error(err.messages, index=index)
 
