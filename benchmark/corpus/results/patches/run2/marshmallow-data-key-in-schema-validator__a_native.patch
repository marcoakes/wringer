diff --git a/tests/test_decorators.py b/tests/test_decorators.py
index a97bf59..027f8a9 100644
--- a/tests/test_decorators.py
+++ b/tests/test_decorators.py
@@ -649,6 +649,93 @@ class TestValidatesSchemaDecorator:
         errors = MySchema().validate({})
         assert errors["arbitrary_key"] == ["Error message"]
 
+    # https://github.com/marshmallow-code/marshmallow/issues/1755
+    def test_field_names_in_error_are_translated_to_data_keys(self):
+        class MySchema(Schema):
+            ip_addresses = fields.String(required=True, data_key="ipAddresses")
+
+            @validates_schema(skip_on_field_errors=False)
+            def validate_with_dict(self, data, **kwargs):
+                raise ValidationError({"ip_addresses": "Dict error."})
+
+            @validates_schema(skip_on_field_errors=False)
+            def validate_with_field_name(self, data, **kwargs):
+                raise ValidationError("Field name error.", field_name="ip_addresses")
+
+            @validates("ip_addresses")
+            def validate_ip_addresses(self, data):
+                raise ValidationError("Field validator error.")
+
+        errors = MySchema().validate({"ipAddresses": "192.168.0.1"})
+        # All errors are reported under the same key, whichever validator raised them
+        assert errors == {
+            "ipAddresses": [
+                "Field validator error.",
+                "Dict error.",
+                "Field name error.",
+            ]
+        }
+
+    def test_data_key_in_error_is_left_as_is(self):
+        class MySchema(Schema):
+            ip_addresses = fields.String(data_key="ipAddresses")
+
+            @validates_schema
+            def validate_with_dict(self, data, **kwargs):
+                raise ValidationError({"ipAddresses": ["Dict error."]})
+
+            @validates_schema
+            def validate_with_field_name(self, data, **kwargs):
+                raise ValidationError("Field name error.", field_name="ipAddresses")
+
+        assert MySchema().validate({}) == {
+            "ipAddresses": ["Dict error.", "Field name error."]
+        }
+
+    def test_field_name_and_data_key_errors_are_merged(self):
+        class MySchema(Schema):
+            ip_addresses = fields.String(data_key="ipAddresses")
+
+            @validates_schema
+            def validator(self, data, **kwargs):
+                raise ValidationError(
+                    {"ip_addresses": ["Error 1"], "ipAddresses": ["Error 2"]}
+                )
+
+        assert MySchema().validate({}) == {"ipAddresses": ["Error 1", "Error 2"]}
+
+    def test_keys_without_a_data_key_are_left_as_is(self):
+        class MySchema(Schema):
+            foo = fields.Int()
+            bar = fields.Int(data_key="Bar")
+
+            @validates_schema
+            def validator(self, data, **kwargs):
+                raise ValidationError(
+                    {"foo": ["Foo error"], "arbitrary_key": ["Arbitrary error"]}
+                )
+
+        assert MySchema().validate({}) == {
+            "foo": ["Foo error"],
+            "arbitrary_key": ["Arbitrary error"],
+        }
+
+    def test_field_names_in_error_are_translated_to_data_keys_many(self):
+        class MySchema(Schema):
+            ip_addresses = fields.String(data_key="ipAddresses")
+
+            @validates_schema
+            def validator(self, data, **kwargs):
+                raise ValidationError("Error message", field_name="ip_addresses")
+
+        errors = MySchema(many=True).validate(
+            [{"ipAddresses": "192.168.0.1"}, {"ipAddresses": "192.168.0.2"}]
+        )
+        assert errors == {
+            0: {"ipAddresses": ["Error message"]},
+            1: {"ipAddresses": ["Error message"]},
+        }
+
