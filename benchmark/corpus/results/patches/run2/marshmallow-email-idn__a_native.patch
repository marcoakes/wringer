diff --git a/tests/test_validate.py b/tests/test_validate.py
index 00fca55..40a71c5 100644
--- a/tests/test_validate.py
+++ b/tests/test_validate.py
@@ -368,6 +368,48 @@ def test_email_invalid(invalid_email):
         validator(invalid_email)
 
 
+@pytest.mark.parametrize(
+    "valid_email",
+    [
+        "গিটহাব@তৌহিদুর.বাংলা",
+        "user@তৌহিদুর.বাংলা",
+        "গিটহাব@example.com",
+        "संपर्क@डाटामेल.भारत",
+        "квіточка@пошта.укр",
+        "чебурашка@почта-россии.рф",
+        "我買@屋企.香港",
+        "user@münchen.de",
+        # punycode form of the same domain
+        "user@xn--mnchen-3ya.de",
+    ],
+)
+def test_email_idn_valid(valid_email):
+    validator = validate.Email()
+    assert validator(valid_email) == valid_email
+
+
+@pytest.mark.parametrize(
+    "invalid_email",
+    [
+        # hyphens are only allowed in the middle of a label
+        "user@-münchen.de",
+        "user@münchen-.de",
+        # empty labels
+        "user@пример..рф",
+        "user@.рф",
+        # no TLD
+        "user@例",
+        # whitespace is not a letter
+        "us er@пример.рф",
+        "user@пример .рф",
+    ],
+)
+def test_email_idn_invalid(invalid_email):
+    validator = validate.Email()
+    with pytest.raises(ValidationError):
+        validator(invalid_email)
+
+
 def test_email_custom_message():
     validator = validate.Email(error="{input} is not an email addy.")
     with pytest.raises(ValidationError, match="invalid is not an email addy."):
