+def test_formatting_usage_error_shadowed_help_name(runner):
+    """The hint skips help names claimed by another parameter. See #2790."""
+
+    @click.group(context_settings={"help_option_names": ["-h", "--help"]})
+    def cmd():
+        pass
+
+    @cmd.command()
+    @click.argument("bar")
+    @click.option("-h", "--host")
+    def foo(bar, host):
+        click.echo(f"foo:{bar}")
+
+    result = runner.invoke(cmd, ["foo"])
+    assert result.exit_code == 2
+    assert result.output.splitlines() == [
+        "Usage: cmd foo [OPTIONS] BAR",
+        "Try 'cmd foo --help' for help.",
+        "",
+        "Error: Missing argument 'BAR'.",
+    ]
+
+    # The group itself keeps the shadowed name, and the suggestion works.
+    result = runner.invoke(cmd, ["foo", "--help"])
+    assert result.exit_code == 0
+    assert "Usage: cmd foo [OPTIONS] BAR" in result.output
+
+
+def test_formatting_usage_error_all_help_names_shadowed(runner):
+    @click.command(context_settings={"help_option_names": ["-h"]})
+    @click.argument("bar")
+    @click.option("-h", "--host")
+    def cmd(bar, host):
+        click.echo(f"cmd:{bar}")
+
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 2
+    assert result.output.splitlines() == [
+        "Usage: cmd [OPTIONS] BAR",
+        "",
+        "Error: Missing argument 'BAR'.",
+    ]
+
+
