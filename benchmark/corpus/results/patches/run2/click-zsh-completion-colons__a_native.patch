+_ZSH_DRIVER = """\
+# Stand in for the pieces of zsh's completion system the generated script
+# calls, so that what it passes to _describe and compadd can be inspected
+# outside of a real completion.
+compdef() { }
+_path_files() { }
+_describe() {
+    # -V unsorted <array name> -U
+    local item
+    for item in "${(@P)3}"; do
+        print -r -- "describe: $item"
+    done
+}
+compadd() {
+    local item
+    for item in "${(@P)argv[-1]}"; do
+        print -r -- "compadd: $item"
+    done
+}
+
+words=(cli '')
+CURRENT=2
+source '%(script)s'
+_cli_completion
+"""
+
+
+@pytest.mark.skipif(shutil.which("zsh") is None, reason="zsh is not installed")
+def test_zsh_colons_in_values(tmp_path):
+    """Colons in a value must reach the shell escaped. ``_describe`` splits
+    each item on the first unescaped colon to separate the value from its
+    description, so an unescaped one truncates the completion. Values added
+    without a description don't go through ``_describe`` and must not be
+    escaped. :issue:`2703`
+    """
+    comp = ZshComplete(Command("cli"), {}, "cli", "_CLI_COMPLETE")
+    items = [CompletionItem("baz:quux", help="adsf"), CompletionItem("spam:eggs")]
+    response = tmp_path / "response"
+    response.write_text("\n".join(comp.format_completion(item) for item in items))
+
+    # The generated script only runs the program if it's on PATH, and calls it
+    # to get the completion response.
+    bin_dir = tmp_path / "bin"
+    bin_dir.mkdir()
+    cli_stub = bin_dir / "cli"
+    cli_stub.write_text(f'#!/bin/sh\nexec cat "{response}"\n')
+    cli_stub.chmod(0o755)
+
+    script = tmp_path / "cli-completion.zsh"
+    script.write_text(comp.source())
+    driver = tmp_path / "driver.zsh"
+    driver.write_text(_ZSH_DRIVER % {"script": script})
+
+    result = subprocess.run(
+        ["zsh", "-f", str(driver)],
+        capture_output=True,
+        text=True,
+        env={**os.environ, "PATH": f"{bin_dir}{os.pathsep}{os.environ['PATH']}"},
+    )
+
+    assert result.stderr == ""
+    assert "describe: baz\\:quux:adsf" in result.stdout
+    assert "compadd: spam:eggs" in result.stdout
+
+
