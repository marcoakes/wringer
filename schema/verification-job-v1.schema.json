{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/verification-job-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.verification-job.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "mode": {
      "const": "verification"
    },
    "parentJobId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "head_sha": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "head_sha",
        "branch",
        "dirty",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "configSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkIdentities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "run": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "run_sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "coverage": {
            "enum": [
              "command-files-and-inputs",
              "command-and-files",
              "command-and-inputs",
              "command-only"
            ]
          }
        },
        "required": [
          "gate_id",
          "run",
          "run_sha256",
          "files",
          "inputs",
          "coverage"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "selection": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 10000
    },
    "ceilings": {
      "type": "object",
      "properties": {
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "elapsedSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "runSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "supervisedCommandsPerRun": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "required": [
        "repetitions",
        "elapsedSeconds",
        "runSeconds",
        "supervisedCommandsPerRun"
      ],
      "additionalProperties": false
    },
    "destination": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "remote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "base": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "remote",
            "base",
            "branch"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "trust": {
      "const": "trusted-local"
    }
  },
  "required": [
    "schema_version",
    "id",
    "workspaceId",
    "mode",
    "parentJobId",
    "intent",
    "createdAt",
    "source",
    "configSha256",
    "checkIdentities",
    "selection",
    "ceilings",
    "destination",
    "trust"
  ],
  "additionalProperties": false
}
