{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/playbook-materialisation-v1.schema.json",
  "title": "playbook-materialisation-v1",
  "description": "Retained before a worker's request on a playbook-tree plan: the evaluator-owned overlay commit made from the approved snapshot on the worker's base (the approved source or a captured candidate), each file at its active path with its exact bytes, and any tracked file it replaced by explicit declaration. Only the worker clones the overlay; capture refuses any change under an overlay path and applies the worker's change to the base. Every reader re-observes the overlay in Git.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planSha256",
    "snapshotSha256",
    "playbookSha256",
    "surface",
    "base",
    "overlay",
    "files",
    "replaced",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.playbook-materialisation.v1"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshotSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "playbookSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "surface": {
      "enum": [
        "claude-code",
        "codex",
        "generic"
      ]
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "commit"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourcePath",
          "activePath",
          "mode",
          "sha256",
          "blob"
        ],
        "properties": {
          "sourcePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "activePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "mode": {
            "enum": [
              "100644",
              "100755"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "blob": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          }
        }
      }
    },
    "replaced": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "uniqueItems": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
