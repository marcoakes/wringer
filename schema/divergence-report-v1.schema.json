{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/divergence-report-v1.schema.json",
  "description": "Where the attempts of one replicate set disagreed, projected from records and validated journals. No model and no causal claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "replicateSetSha256",
    "planSha256",
    "k",
    "recorded",
    "evidenceKinds",
    "replicates",
    "checks",
    "judge",
    "loopDecisions",
    "candidates",
    "firstFailure",
    "diverging",
    "limits",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.divergence-report.v1"
    },
    "replicateSetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "k": {
      "type": "integer",
      "minimum": 2,
      "maximum": 5
    },
    "recorded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "evidenceKinds": {
      "type": "array",
      "items": {
        "enum": [
          "live",
          "deterministic-fixture"
        ]
      },
      "maxItems": 2
    },
    "replicates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "outcome",
          "candidateTree",
          "workerAttempts",
          "firstFailure"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "outcome": {
            "enum": [
              "completed",
              "human-hold",
              "stopped",
              "infrastructure-failed",
              "uncertain",
              "not-started"
            ]
          },
          "candidateTree": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "workerAttempts": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "firstFailure": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "attempt",
                  "kind",
                  "requirementIds"
                ],
                "properties": {
                  "attempt": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "kind": {
                    "enum": [
                      "environment",
                      "product-check",
                      "agent-finding",
                      "human-preference"
                    ]
                  },
                  "requirementIds": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outcomes",
          "agreement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "outcomes": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "enum": [
                "passed",
                "failed",
                "unavailable",
                "not-run",
                null
              ]
            }
          },
          "agreement": {
            "enum": [
              "agree",
              "diverge",
              "incomplete"
            ]
          }
        }
      }
    },
    "judge": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outcomes",
          "agreement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "outcomes": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "agreement": {
            "enum": [
              "agree",
              "diverge",
              "incomplete"
            ]
          }
        }
      }
    },
    "loopDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequences",
        "agreement"
      ],
      "properties": {
        "sequences": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 32
                }
              }
            ]
          }
        },
        "agreement": {
          "enum": [
            "agree",
            "diverge",
            "incomplete"
          ]
        }
      }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinctTrees",
        "agreement"
      ],
      "properties": {
        "distinctTrees": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "agreement": {
          "enum": [
            "agree",
            "diverge",
            "incomplete"
          ]
        }
      }
    },
    "firstFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agreement"
      ],
      "properties": {
        "agreement": {
          "enum": [
            "agree",
            "diverge",
            "incomplete"
          ]
        }
      }
    },
    "diverging": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "limits": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "title": "divergence-report-v1"
}
