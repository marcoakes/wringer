{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/delegation-context-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.delegation-context.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "parentJobId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "destination": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "remote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "sourceBranch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "targetBranch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "remote",
            "sourceBranch",
            "targetBranch"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "workspaceId",
    "profileId",
    "intent",
    "parentJobId",
    "createdAt",
    "destination"
  ],
  "additionalProperties": false
}
