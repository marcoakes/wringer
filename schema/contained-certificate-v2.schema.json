{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/contained-certificate-v2.schema.json",
  "title": "Contained certificate v2",
  "description": "Copies the validated v2 view with explicit check evidence levels and source-bound playbook use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "viewSha256",
    "view",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.contained-certificate.v2"
    },
    "viewSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "view": {
      "type": "object",
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "const": "wringer.contained-delivery-view.v2"
        }
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
