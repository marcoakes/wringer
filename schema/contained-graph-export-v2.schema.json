{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable parallel contained graph export",
  "description": "graph.json of a version 2 graph export. As version 1, plus each join's integration record and the portable summary of every fresh verification of the integrated candidate, bound to the join's recorded result. A delivery of a join-owned candidate carries this export itself in its evidence commit, so it has no nested loop delivery envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph",
    "revision",
    "eventCount",
    "files",
    "nodes",
    "omissions",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.contained-graph-export.v2"
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "repository"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 80
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "commit"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "commit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "eventCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(graph|nodes)/[A-Za-z0-9._/-]+$|^(read-bundle\\.mjs|schema\\.json|summary\\.md)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "evidence",
          "prepared",
          "delivery"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "loop",
              "check",
              "human-hold",
              "delivery",
              "join"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "prepared": {
            "type": [
              "string",
              "null"
            ]
          },
          "delivery": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^deliveries/[a-z][a-z0-9-]*$"
              }
            ]
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "reason"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
