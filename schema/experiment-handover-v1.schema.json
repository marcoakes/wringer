{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/experiment-handover-v1.schema.json",
  "title": "experiment-handover-v1",
  "description": "Separate private local experimental handover and literal fresh-clone audit. No production destination, forge, deployment or human acceptance is authorised.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experimentSha256",
    "slotId",
    "planSha256",
    "candidateCommit",
    "candidateTree",
    "journeyRevision",
    "evidenceKind",
    "target",
    "registrationSha256",
    "status",
    "measuredAt",
    "delivery",
    "freshClone",
    "productionPublication",
    "productionHumanApproval",
    "reason",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.experiment-handover.v1"
    },
    "experimentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "slotId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,179}$"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateTree": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "journeyRevision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceKind": {
      "enum": [
        "live-contained",
        "deterministic-fixture"
      ]
    },
    "target": {
      "const": "generated-private-local-origin-only"
    },
    "registrationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "unknown"
      ]
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time"
    },
    "delivery": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deliveryId",
            "codeCommit",
            "evidenceCommit",
            "sourceBranch",
            "targetBranch",
            "pushed"
          ],
          "properties": {
            "deliveryId": {
              "type": "string",
              "pattern": "^contained-[a-f0-9]{24}$"
            },
            "codeCommit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "evidenceCommit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "sourceBranch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "targetBranch": {
              "const": "main"
            },
            "pushed": {
              "const": true
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "freshClone": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headCommit",
            "audit"
          ],
          "properties": {
            "headCommit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "audit": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "status",
                "deliveryId",
                "codeCommit",
                "checks",
                "human",
                "claims",
                "limits"
              ],
              "properties": {
                "schema_version": {
                  "const": "wringer.contained-audit.v1"
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed"
                  ]
                },
                "deliveryId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "codeCommit": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "checks": {
                  "type": "integer",
                  "minimum": 0
                },
                "human": {
                  "type": "integer",
                  "minimum": 0
                },
                "claims": {
                  "type": "array",
                  "maxItems": 100000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "status",
                      "reason"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "status": {
                        "enum": [
                          "checked",
                          "failed"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    }
                  }
                },
                "limits": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "productionPublication": {
      "const": "not-attempted"
    },
    "productionHumanApproval": {
      "const": "not-granted"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
