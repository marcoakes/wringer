{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/archive-removal-result-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.archive-removal-result.v1"
    },
    "archiveId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "removed": {
      "const": true
    },
    "retainedLineage": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "archiveId",
    "identity",
    "removed",
    "retainedLineage"
  ],
  "additionalProperties": false
}
