{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/verification-recovery-preview-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.verification-recovery-preview.v1"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "operationIdentity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bundleIdentity": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner": {
      "enum": [
        "absent",
        "live",
        "dead",
        "unknown"
      ]
    },
    "eligible": {
      "type": "boolean"
    },
    "observation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "wringer.verification-observation.v1"
            },
            "operationId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "jobId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "evidence": {
              "type": "string",
              "pattern": "^\\.wringer/runs/verification-[a-f0-9-]{36}$"
            },
            "exit": {
              "enum": [
                0,
                1,
                2,
                4
              ]
            },
            "source": {
              "type": "object",
              "properties": {
                "head_sha": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "branch": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dirty": {
                  "type": "boolean"
                },
                "fingerprint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "head_sha",
                "branch",
                "dirty",
                "fingerprint"
              ],
              "additionalProperties": false
            },
            "outcome": {
              "enum": [
                "completed",
                "interrupted"
              ]
            },
            "displays": {
              "type": "array",
              "maxItems": 0
            }
          },
          "required": [
            "schema_version",
            "operationId",
            "jobId",
            "at",
            "evidence",
            "exit",
            "source",
            "outcome",
            "displays"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string"
    },
    "dispatched": {
      "const": false
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "jobId",
    "operationId",
    "operationIdentity",
    "bundleIdentity",
    "owner",
    "eligible",
    "observation",
    "reason",
    "dispatched",
    "identity"
  ],
  "additionalProperties": false
}
