{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/delegation-recovery-result-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.delegation-recovery-result.v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "operationId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "resultIdentity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dispatched": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "identity",
    "jobId",
    "operationId",
    "resultIdentity",
    "dispatched"
  ],
  "additionalProperties": false
}
