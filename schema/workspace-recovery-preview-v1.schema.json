{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/workspace-recovery-preview-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.workspace-recovery-preview.v1"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "mode": {
      "enum": [
        "verification",
        "delegation"
      ]
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "owner.lock",
              "connection.json",
              "operator.json"
            ]
          },
          "identity": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          }
        },
        "required": [
          "name",
          "identity",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "ownerState": {
      "enum": [
        "live",
        "dead",
        "unknown"
      ]
    },
    "eligible": {
      "type": "boolean"
    },
    "action": {
      "const": "retain-dead-page-owner"
    },
    "dispatched": {
      "const": false
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "workspaceId",
    "mode",
    "pid",
    "files",
    "ownerState",
    "eligible",
    "action",
    "dispatched",
    "reason",
    "identity"
  ],
  "additionalProperties": false
}
