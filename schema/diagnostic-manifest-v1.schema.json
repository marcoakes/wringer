{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/diagnostic-manifest-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.diagnostic-manifest.v1"
    },
    "included": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "const": "report.json"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 524288
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 20
    },
    "sharing": {
      "const": "Inspect this export before deliberately sharing it. No upload is performed."
    }
  },
  "required": [
    "schema_version",
    "included",
    "excluded",
    "sharing"
  ],
  "additionalProperties": false
}
