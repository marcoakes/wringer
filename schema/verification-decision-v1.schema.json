{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/verification-decision-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.verification-decision.v1"
    },
    "candidateIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "enum": [
        "met",
        "not_met"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "candidateIdentity",
    "revision",
    "verdict",
    "actor",
    "at"
  ],
  "additionalProperties": false
}
