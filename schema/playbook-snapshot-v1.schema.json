{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/playbook-snapshot-v1.schema.json",
  "title": "Exact source-bound worker playbook snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "content",
    "manifest",
    "sha256",
    "snapshot_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.playbook-snapshot.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "blob"
      ],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "commit"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(https|ssh)://[^\\s]+$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            }
          }
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "blob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      }
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "revision",
        "title",
        "role",
        "applicability",
        "guidanceMarkdown",
        "limits",
        "evaluationRefs"
      ],
      "properties": {
        "schema_version": {
          "const": "wringer.playbook.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "const": "worker"
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "taskFamily",
            "context",
            "tools",
            "checks",
            "scope",
            "design"
          ],
          "properties": {
            "taskFamily": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "context": {
              "type": "array",
              "minItems": 0,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "tools": {
              "type": "array",
              "minItems": 0,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              }
            },
            "checks": {
              "type": "array",
              "minItems": 0,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              }
            },
            "scope": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "design": {
              "type": "boolean"
            }
          }
        },
        "guidanceMarkdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 49152
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "evaluationRefs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
