{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/playbook-snapshot-v3.schema.json",
  "title": "Exact source-bound worker playbook tree snapshot v3",
  "description": "The manifest and every file of an approved playbook tree, read from the approved commit with each digest checked, hosted or local-only source alike. The materialisation record binds the overlay commit built from these bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "content",
    "manifest",
    "sha256",
    "files",
    "snapshot_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.playbook-snapshot.v3"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "blob"
      ],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "commit"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^((https|ssh)://[^\\s]+|local://[a-f0-9]{40})$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            }
          }
        },
        "path": {
          "type": "string",
          "pattern": "^wringer/playbooks/[A-Za-z0-9][A-Za-z0-9_-]{0,63}/manifest\\.json$"
        },
        "blob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      }
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "revision",
        "title",
        "role",
        "taskFamily",
        "surface",
        "files",
        "limits",
        "evaluationRefs"
      ],
      "properties": {
        "schema_version": {
          "const": "wringer.playbook.v2"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "const": "worker"
        },
        "taskFamily": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "surface": {
          "enum": [
            "claude-code",
            "codex",
            "generic"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "kind"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "description": "Relative to the manifest directory."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "kind": {
                "enum": [
                  "always-on",
                  "skill",
                  "script",
                  "subagent",
                  "notes"
                ]
              }
            }
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        },
        "evaluationRefs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uniqueItems": true
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "blob",
          "mode",
          "sha256",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "blob": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "mode": {
            "enum": [
              "100644",
              "100755"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content": {
            "type": "string",
            "maxLength": 262144
          }
        }
      }
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
