{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/contained-certificate-v1.schema.json",
  "title": "Contained certificate v1",
  "description": "Copies the separately validated contained-delivery-view.v1, whose canonical digest must equal viewSha256. Does not grant authority.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "viewSha256", "view", "limits"],
  "properties": {
    "schema_version": {"const": "wringer.contained-certificate.v1"},
    "viewSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "view": {"type": "object", "required": ["schema_version"], "properties": {"schema_version": {"const": "wringer.contained-delivery-view.v1"}}},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
