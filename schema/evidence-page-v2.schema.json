{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/evidence-page-v2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.evidence-page.v2"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "contentIdentity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content": {
      "type": "string",
      "maxLength": 8192
    },
    "nextOffset": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "untrustedContent": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "jobId",
    "contentIdentity",
    "content",
    "nextOffset",
    "untrustedContent"
  ],
  "additionalProperties": false
}
