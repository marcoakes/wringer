{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/execution-plan-v1.schema.json",
  "title": "Native execution plan v1",
  "description": "Frozen structural contract. Source/digest equality, authority ceilings, scope containment, policy semantics and observed truth require the native semantic validators in addition to this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "intent",
    "intent_sha256",
    "repository",
    "runtime",
    "agents",
    "environment",
    "scope",
    "acceptance",
    "acceptance_sha256",
    "budget",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.execution-plan.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "runtime": {
      "$ref": "#/$defs/policy"
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker",
        "judge"
      ],
      "properties": {
        "worker": {
          "$ref": "#/$defs/agent"
        },
        "judge": {
          "$ref": "#/$defs/agent"
        },
        "planner": {
          "$ref": "#/$defs/agent"
        }
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writable"
      ],
      "properties": {
        "writable": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        }
      }
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance"
    },
    "acceptance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "path": {
      "anyOf": [
        {
          "const": "."
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.git|\\.wringer|\\.\\.?)(?:/|$))[^\\\\\\u0000\\r\\n\\t:*?\\[\\]]+$"
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "timeout_seconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          }
        },
        "cwd": {
          "$ref": "#/$defs/path"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_sessions",
        "max_worker_turns",
        "max_judge_turns",
        "max_planner_turns",
        "wall_clock_seconds",
        "session_timeout_seconds"
      ],
      "properties": {
        "max_sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_worker_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_judge_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_planner_turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "wall_clock_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "session_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "commit"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https|ssh)://[^\\s]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "command",
        "args",
        "env"
      ],
      "properties": {
        "protocol": {
          "const": "acp"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "args": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          }
        },
        "env": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "authMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "allow",
        "dns"
      ],
      "properties": {
        "policy": {
          "enum": [
            "deny",
            "allowlist"
          ]
        },
        "allow": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cidr",
              "ports"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([1-9]|[12][0-9]|3[0-2])$"
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "uniqueItems": true
              }
            }
          }
        },
        "dns": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          }
        }
      }
    },
    "policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "image",
            "cpus",
            "memoryMiB",
            "network",
            "env"
          ],
          "properties": {
            "kind": {
              "const": "apple-container"
            },
            "image": {
              "type": "string",
              "pattern": "^\\S+@sha256:[a-f0-9]{64}$"
            },
            "cpus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 128,
              "maximum": 262144
            },
            "network": {
              "$ref": "#/$defs/network"
            },
            "env": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "image",
            "cpus",
            "memoryMiB",
            "network",
            "env",
            "context",
            "namespace",
            "runtimeClass"
          ],
          "properties": {
            "kind": {
              "const": "gvisor-kubernetes"
            },
            "image": {
              "type": "string",
              "pattern": "^\\S+@sha256:[a-f0-9]{64}$"
            },
            "cpus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 128,
              "maximum": 262144
            },
            "network": {
              "$ref": "#/$defs/network"
            },
            "env": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "uniqueItems": true
            },
            "context": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            },
            "namespace": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "runtimeClass": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "secretRefs": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1048576
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1048576
                  }
                }
              }
            }
          }
        }
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "checks",
        "protected_paths"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "quote",
              "kind",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "kind": {
                "enum": [
                  "check",
                  "human"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "show": {
                "$ref": "#/$defs/command"
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "argv",
              "cwd",
              "timeout_seconds",
              "criteria",
              "files"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1048576
                }
              },
              "cwd": {
                "$ref": "#/$defs/path"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "criteria": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "uniqueItems": true
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "$ref": "#/$defs/path"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "protected_paths": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "tools",
        "setup",
        "baseline",
        "writable_directories"
      ],
      "properties": {
        "context": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "probe"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "probe": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1048576
                }
              }
            }
          }
        },
        "setup": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "baseline": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "writable_directories": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
