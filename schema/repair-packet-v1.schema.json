{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded actionable controller observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "planSha256",
    "acceptanceSha256",
    "candidateCommit",
    "candidateTree",
    "observationSha256",
    "checks",
    "omittedChecks",
    "limits",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.repair-packet.v1"
    },
    "phase": {
      "enum": [
        "baseline",
        "candidate"
      ]
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptanceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "candidateTree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "observationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "argv",
          "cwd",
          "requirements",
          "status",
          "exitCode",
          "outputSha256",
          "stdout",
          "stderr",
          "omittedBytes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "acceptance",
              "regression"
            ]
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "requirements": {
            "type": "array",
            "minItems": 0,
            "maxItems": 128,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unavailable"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "outputSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stdout": {
            "type": "string",
            "maxLength": 2052
          },
          "stderr": {
            "type": "string",
            "maxLength": 2052
          },
          "omittedBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "omittedChecks": {
      "type": "integer",
      "minimum": 0
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
