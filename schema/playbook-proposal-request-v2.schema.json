{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/playbook-proposal-request-v2.schema.json",
  "title": "playbook-proposal-request-v2",
  "description": "One separate finite allowance for one worker-kind proposer session that reads a proposer-evidence tree in its clone and may write only wringer/proposals/<id>/: a playbook-tree proposal or a KEEP_BASE note. The proposer's own plan may be contained or trusted-local. Private bounded research record. Structural validity is not live efficacy, independent human presence or production execution/publication authority. Application readers additionally validate exact source/plan/evidence identity and chronology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan",
    "proposalId",
    "outputDirectory",
    "surface",
    "dimension",
    "taskFamily",
    "baseline",
    "evidence",
    "replicateSet",
    "prediction",
    "actor",
    "grantedAt",
    "expiresAt",
    "maxSessions",
    "maxTurns",
    "wallClockSeconds",
    "credentialNames",
    "dataScope",
    "action",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.playbook-proposal-request.v2"
    },
    "plan": {
      "type": "object",
      "required": [
        "schema_version",
        "plan_sha256",
        "acceptance_sha256",
        "repository",
        "runtime",
        "agents",
        "scope",
        "acceptance",
        "budget"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "wringer.execution-plan.v1",
            "wringer.execution-plan.v2",
            "wringer.execution-plan.v3",
            "wringer.execution-plan.v4",
            "wringer.execution-plan.v5",
            "wringer.execution-plan.v6"
          ]
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "acceptance_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "description": "Full compiled plan is additionally validated by the inert plan reader, including semantic hashes and authority."
    },
    "proposalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "outputDirectory": {
      "type": "string",
      "pattern": "^wringer/proposals/[a-z][a-z0-9-]{0,79}$"
    },
    "surface": {
      "enum": [
        "claude-code",
        "codex",
        "generic"
      ]
    },
    "dimension": {
      "enum": [
        "procedure",
        "domain",
        "both"
      ]
    },
    "taskFamily": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "baseline": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "schema_version",
            "source",
            "content",
            "manifest",
            "sha256",
            "snapshot_sha256"
          ],
          "properties": {
            "schema_version": {
              "enum": [
                "wringer.playbook-snapshot.v1",
                "wringer.playbook-snapshot.v2",
                "wringer.playbook-snapshot.v3"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "snapshot_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "description": "Validated by the native playbook snapshot reader for its version."
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "schema_version",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "wringer.proposer-evidence.v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "description": "The full proposer-evidence-v1 record."
    },
    "replicateSet": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "divergenceSha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "divergenceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "metric",
        "minimumImprovement",
        "minimumHeldOutPairs",
        "maximumSignProbability",
        "visualQualityClaim"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "metric": {
          "enum": [
            "worker-attempts",
            "functional-completion"
          ]
        },
        "minimumImprovement": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "minimumHeldOutPairs": {
          "type": "integer",
          "minimum": 4,
          "maximum": 128
        },
        "maximumSignProbability": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.05
        },
        "visualQualityClaim": {
          "type": "boolean"
        }
      }
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "grantedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "maxSessions": {
      "const": 1
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "wallClockSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "credentialNames": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "dataScope": {
      "const": "this-repository-only"
    },
    "action": {
      "const": "propose-one-worker-playbook-tree"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
