{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/runtime-v2.schema.json",
  "title": "Local-source contained runtime provenance v2",
  "description": "Local-only source sibling: identical to its predecessor except that the repository is local://<the single root commit of its history>, read only from the Git bundle prepared beside the profile. Hosted sources keep the predecessor. Frozen structural contract. Source/digest equality, authority ceilings, scope containment, policy semantics and observed truth require the native semantic validators in addition to this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtimeId",
    "role",
    "kind",
    "image",
    "repository",
    "clonedInside",
    "hostMounts",
    "repositoryAccess",
    "declared",
    "observed",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.runtime.v2"
    },
    "runtimeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "role": {
      "enum": [
        "planner",
        "worker",
        "judge",
        "verifier"
      ]
    },
    "kind": {
      "enum": [
        "apple-container",
        "gvisor-kubernetes"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^\\S+@sha256:[a-f0-9]{64}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "commit"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^local://[a-f0-9]{40}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "bundlePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      }
    },
    "clonedInside": {
      "const": true
    },
    "hostMounts": {
      "type": "array",
      "maxItems": 0
    },
    "repositoryAccess": {
      "enum": [
        "read-only",
        "read-write"
      ]
    },
    "declared": {
      "$ref": "#/$defs/policy"
    },
    "observed": {
      "type": "object"
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1048576
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "worker"
          }
        }
      },
      "then": {
        "properties": {
          "repositoryAccess": {
            "const": "read-write"
          }
        }
      },
      "else": {
        "properties": {
          "repositoryAccess": {
            "const": "read-only"
          }
        }
      }
    }
  ],
  "$defs": {
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "allow",
        "dns"
      ],
      "properties": {
        "policy": {
          "enum": [
            "deny",
            "allowlist"
          ]
        },
        "allow": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cidr",
              "ports"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([1-9]|[12][0-9]|3[0-2])$"
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "uniqueItems": true
              }
            }
          }
        },
        "dns": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          }
        }
      }
    },
    "policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "image",
            "cpus",
            "memoryMiB",
            "network",
            "env"
          ],
          "properties": {
            "kind": {
              "const": "apple-container"
            },
            "image": {
              "type": "string",
              "pattern": "^\\S+@sha256:[a-f0-9]{64}$"
            },
            "cpus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 128,
              "maximum": 262144
            },
            "network": {
              "$ref": "#/$defs/network"
            },
            "env": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "uniqueItems": true
            },
            "binary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "image",
            "cpus",
            "memoryMiB",
            "network",
            "env",
            "context",
            "namespace",
            "runtimeClass"
          ],
          "properties": {
            "kind": {
              "const": "gvisor-kubernetes"
            },
            "image": {
              "type": "string",
              "pattern": "^\\S+@sha256:[a-f0-9]{64}$"
            },
            "cpus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 128,
              "maximum": 262144
            },
            "network": {
              "$ref": "#/$defs/network"
            },
            "env": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "uniqueItems": true
            },
            "context": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            },
            "namespace": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "runtimeClass": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "secretRefs": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1048576
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1048576
                  }
                }
              }
            },
            "binary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            }
          }
        }
      ]
    }
  }
}
