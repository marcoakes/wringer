{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/environment-map-v1.schema.json",
  "title": "Native source-linked environment map v1",
  "description": "Frozen structural contract. Source/digest equality, authority ceilings, scope containment, policy semantics and observed truth require the native semantic validators in addition to this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "plan_sha256",
    "source_tree",
    "inventory_sha256",
    "files",
    "context",
    "components",
    "tools",
    "baseline",
    "protected_paths",
    "writable_paths",
    "limits",
    "map_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.environment-map.v1"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mode",
          "blob"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          },
          "mode": {
            "enum": [
              "100644",
              "100755",
              "120000",
              "160000"
            ]
          },
          "blob": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          }
        }
      }
    },
    "context": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "blob",
          "text",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "blob": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "text": {
            "type": "string",
            "maxLength": 1048576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "files"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          },
          "files": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "probe",
          "observation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          },
          "probe": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            }
          },
          "observation": {
            "anyOf": [
              {
                "$ref": "#/$defs/observation"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "baseline": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "declaration",
          "observation"
        ],
        "properties": {
          "declaration": {
            "$ref": "#/$defs/command"
          },
          "observation": {
            "anyOf": [
              {
                "$ref": "#/$defs/observation"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "protected_paths": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "writable_paths": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1048576
      }
    },
    "map_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "commit"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https|ssh)://[^\\s]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      }
    },
    "path": {
      "anyOf": [
        {
          "const": "."
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.git|\\.wringer|\\.\\.?)(?:/|$))[^\\\\\\u0000\\r\\n\\t:*?\\[\\]]+$"
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "timeout_seconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          }
        },
        "cwd": {
          "$ref": "#/$defs/path"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "status",
        "exit_code",
        "output",
        "source_commit",
        "runtime_id",
        "image",
        "command_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tool",
            "baseline"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unavailable"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output": {
          "type": "string",
          "maxLength": 1048576
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "image": {
          "type": "string",
          "pattern": "^\\S+@sha256:[a-f0-9]{64}$"
        },
        "command_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer",
                "not": {
                  "const": 0
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
