{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/experiment-trial-v1.schema.json",
  "title": "experiment-trial-v1",
  "description": "Private bounded research record. Structural validity is not live efficacy, independent human presence or production execution/publication authority. Application readers additionally validate exact source/plan/evidence identity and chronology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experimentSha256",
    "slot",
    "registrationSha256",
    "startedAt",
    "finishedAt",
    "evidenceKind",
    "outcome",
    "workerAttempts",
    "roleSessions",
    "functionalCompletion",
    "requirements",
    "safety",
    "safetyEvidence",
    "candidateCommit",
    "candidateTree",
    "journeyRevision",
    "runtimeIds",
    "agentIdentitySha256",
    "stopReason",
    "cost",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.experiment-trial.v1"
    },
    "experimentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "taskId",
        "repetition",
        "arm",
        "planSha256",
        "reservedSessions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "arm": {
          "enum": [
            "baseline",
            "candidate"
          ]
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reservedSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "registrationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceKind": {
      "enum": [
        "live-contained",
        "deterministic-fixture"
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "human-hold",
        "stopped",
        "infrastructure-failed",
        "uncertain",
        "not-started"
      ]
    },
    "workerAttempts": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "roleSessions": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "functionalCompletion": {
      "type": "boolean"
    },
    "requirements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "met"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "check",
              "human"
            ]
          },
          "met": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "acceptance",
        "containment",
        "secrets",
        "productionPublication",
        "handoverAudit"
      ],
      "properties": {
        "authority": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "acceptance": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "containment": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "secrets": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "productionPublication": {
          "const": "not-attempted"
        },
        "handoverAudit": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        }
      }
    },
    "safetyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "acceptance",
        "containment",
        "secrets",
        "handoverAudit"
      ],
      "properties": {
        "authority": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "containment": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "secrets": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scanner",
                "inputsSha256",
                "inputCount"
              ],
              "properties": {
                "scanner": {
                  "const": "declared-credential-and-pattern-redactor"
                },
                "inputsSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "inputCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "handoverAudit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "candidateCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateTree": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "journeyRevision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16400,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "agentIdentitySha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stopReason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "cost": {
      "type": "null"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
