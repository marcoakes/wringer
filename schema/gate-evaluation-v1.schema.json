      "additionalProperties": false,
      "required": [
        "qualified",
        "reasons"
      ],
      "properties": {
        "qualified": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "evaluatedAt": {
      "type": "string",
