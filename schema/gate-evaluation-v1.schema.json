                },
                "controlsPassed": {
                  "type": "integer",
                  "minimum": 0
                },
                "unavailable": {
                  "type": "integer",
                  "minimum": 0
                },
                "passRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "requiredHolds": {
              "type": "integer",
              "minimum": 0
            },
            "gateRuns": {
              "type": "integer",
              "minimum": 0
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all",
            "development",
            "heldOut",
            "requiredHolds",
            "gateRuns",
            "durationMs"
          ],
          "properties": {
            "all": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "items",
                "defects",
