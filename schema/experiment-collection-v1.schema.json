{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/experiment-collection-v1.schema.json",
  "title": "experiment-collection-v1",
  "description": "Private bounded research record. Structural validity is not live efficacy, independent human presence or production execution/publication authority. Application readers additionally validate exact source/plan/evidence identity and chronology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registrationSha256",
    "grant",
    "startedAt",
    "deadline",
    "evidenceKind",
    "reservations",
    "slots",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.experiment-collection.v1"
    },
    "registrationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "experimentSha256",
        "actor",
        "grantedAt",
        "expiresAt",
        "limits",
        "credentialNames",
        "dataScope",
        "actions",
        "noProductionPublication",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "wringer.experiment-grant.v1"
        },
        "experimentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxTrials",
            "maxRoleSessions",
            "wallClockSeconds"
          ],
          "properties": {
            "maxTrials": {
              "type": "integer",
              "minimum": 2,
              "maximum": 128
            },
            "maxRoleSessions": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4096
            },
            "wallClockSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800
            }
          }
        },
        "credentialNames": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "dataScope": {
          "const": "this-repository-only"
        },
        "actions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "const": "collect-private-trials"
            },
            {
              "const": "measure-private-handover"
            }
          ],
          "items": false
        },
        "noProductionPublication": {
          "const": true
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceKind": {
      "enum": [
        "live-contained",
        "deterministic-fixture"
      ]
    },
    "reservations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "taskId",
          "repetition",
          "arm",
          "planSha256",
          "reservedSessions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "taskId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "repetition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "arm": {
            "enum": [
              "baseline",
              "candidate"
            ]
          },
          "planSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reservedSessions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "dispatchedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "status": {
            "enum": [
              "reserved",
              "dispatched",
              "recorded"
            ]
          },
          "dispatchedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
