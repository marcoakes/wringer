{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/verification-completion-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.verification-completion.v1"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "interrupted"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        4
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "selection_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "exit_code",
    "fingerprint",
    "completed_at",
    "selection_sha256"
  ],
  "additionalProperties": false
}
