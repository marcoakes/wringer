{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A proposed change to how work is checked",
  "description": "An inert proposal: the candidate gate set with every file pinned by content, the author's rationale and every corpus item the author saw. It grants nothing and cannot evaluate itself; a proposal that saw a held-out item cannot be registered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "taskFamily",
    "candidateGates",
    "rationale",
    "inputs",
    "author",
    "createdAt",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.gate-proposal.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 80
    },
    "taskFamily": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 80
    },
    "candidateGates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv",
          "cwd",
          "timeout_seconds",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "files": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "content"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "content": {
                  "type": "string",
                  "maxLength": 262144
                }
              }
            }
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "developmentItems"
      ],
      "properties": {
        "developmentItems": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          }
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "kind"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "operator",
            "delegated-agent"
          ]
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
