{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A future-only gate selection decision",
  "description": "An append-only, revision-checked record that selects (or undoes) a qualified candidate gate set for future plans only. It never edits an active plan, grader, approval or old evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "taskFamily",
    "repository",
    "gates",
    "experimentSha256",
    "evaluationSha256",
    "previousSha256",
    "actor",
    "at",
    "futureOnly",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.gate-adoption.v1"
    },
    "action": {
      "enum": [
        "adopt",
        "undo"
      ]
    },
    "taskFamily": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 80
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "gates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv",
          "cwd",
          "timeout_seconds",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "files": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "content"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "content": {
                  "type": "string",
                  "maxLength": 262144
                }
              }
            }
          }
        }
      }
    },
    "experimentSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "evaluationSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "previousSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "futureOnly": {
      "const": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
