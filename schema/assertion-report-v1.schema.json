{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected check runner assertion report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assertions",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer-check.v1"
    },
    "assertions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirements",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
