{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/design-snapshot-v1.schema.json",
  "title": "DesignSnapshotV1",
  "description": "Immutable design input snapshot. Hashes bind captured bytes, not ownership, remote server honesty or human approval. Private inputs require a separate explicit repository disclosure before attachment. PNG pixels are not proven secret-free.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","title","source","captured_at","disclosure","context","component_rules","assets","provenance","snapshot_sha256"],
  "properties": {
    "schema_version": {"const":"wringer.design-snapshot.v1"},
    "title":{"type":"string","minLength":1,"maxLength":500},
    "source": {
      "type":"object","additionalProperties":false,
      "required":["provider","label","endpoint","file_key","node_id","version","version_basis"],
      "properties": {
        "provider":{"enum":["owned-reference","figma","generic-mcp"]},
        "label":{"type":"string","minLength":1,"maxLength":500},
        "endpoint":{"type":["string","null"],"maxLength":4096},
        "file_key":{"type":["string","null"],"maxLength":4096},
        "node_id":{"type":["string","null"],"maxLength":4096},
        "version":{"type":["string","null"],"maxLength":4096},
        "version_basis":{"enum":["reported","operator-declared","capture-only"]}
      }
    },
    "captured_at":{"type":"string","format":"date-time"},
    "disclosure":{"enum":["private","repository-permitted"]},
    "context":{"type":"string","maxLength":2097152},
    "component_rules":{"type":"array","maxItems":100,"items":{"type":"string","minLength":1,"maxLength":8192}},
    "assets":{"type":"array","maxItems":8,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","title","media_type","width","height","base64","sha256"],
      "properties":{
        "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
        "title":{"type":"string","minLength":1,"maxLength":500},
        "media_type":{"const":"image/png"},
        "width":{"type":"integer","minimum":1,"maximum":4096},
        "height":{"type":"integer","minimum":1,"maximum":4096},
        "base64":{"type":"string","maxLength":5592408,"pattern":"^[A-Za-z0-9+/]*={0,2}$"},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    }},
    "provenance":{
      "type":"object","additionalProperties":false,"required":["method","calls","limits"],
      "properties":{
        "method":{"enum":["owned-reference","mcp-read"]},
        "calls":{"type":"array","maxItems":12,"items":{
          "type":"object","additionalProperties":false,"required":["tool","arguments_sha256","response_sha256"],
          "properties":{
            "tool":{"type":"string","minLength":1,"maxLength":120},
            "arguments_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
            "response_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
          }
        }},
        "limits":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"string","minLength":1,"maxLength":2000}}
      }
    },
    "snapshot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
