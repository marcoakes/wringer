{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/acceptance-input-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.acceptance-input.v1"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "title",
          "quote"
        ],
        "additionalProperties": false
      },
      "maxItems": 64,
      "minItems": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220,
            "pattern": "^wringer-acceptance/[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "contents": {
            "type": "string",
            "minLength": 1,
            "maxLength": 524288
          }
        },
        "required": [
          "path",
          "contents"
        ],
        "additionalProperties": false
      },
      "maxItems": 64,
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "run": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 64,
            "minItems": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "maxItems": 64,
            "minItems": 1
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "adapter": {
            "enum": [
              "node-test",
              "vitest",
              "playwright"
            ]
          }
        },
        "required": [
          "id",
          "run",
          "inputs",
          "requirements"
        ],
        "additionalProperties": false
      },
      "maxItems": 64,
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "requirements",
    "files",
    "checks"
  ],
  "additionalProperties": false
}
