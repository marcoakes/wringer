{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/playbook-v2.schema.json",
  "title": "Inert worker-only playbook tree manifest",
  "description": "Advisory data for one adapter surface. The manifest lists every file of the tree with its exact digest and kind. Exactly one always-on file (CLAUDE.md for claude-code, AGENTS.md for codex, PLAYBOOK.md for generic, at most 8 KiB); skills at skills/<name>/SKILL.md with name and description front matter, each named in the always-on file; scripts parse in a declared toolchain; no hooks, tools or permissions; no detected credential; at most 256 KiB in all. No metadata or instruction grants execution, tools, changed policy or human authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "title",
    "role",
    "taskFamily",
    "surface",
    "files",
    "limits",
    "evaluationRefs"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.playbook.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "role": {
      "const": "worker"
    },
    "taskFamily": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "surface": {
      "enum": [
        "claude-code",
        "codex",
        "generic"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Relative to the manifest directory."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "always-on",
              "skill",
              "script",
              "subagent",
              "notes"
            ]
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "uniqueItems": true
    },
    "evaluationRefs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    }
  }
}
