{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/proposer-evidence-v1.schema.json",
  "title": "proposer-evidence-v1",
  "description": "The evidence tree a playbook proposer reads in its clone under wringer/evidence/: the task, what each journey did (its rendered trajectory) and produced, where replicates disagreed, the current playbook and the lessons library. Built offline from validated journals, redacted again, and scanned by name and content for held-out material before it is written. Private bounded research record. Structural validity is not live efficacy, independent human presence or production execution/publication authority. Application readers additionally validate exact source/plan/evidence identity and chronology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planSha256",
    "repository",
    "taskFamily",
    "replicateSetSha256",
    "divergenceSha256",
    "patternsSha256",
    "baselineSha256",
    "lessons",
    "journeys",
    "files",
    "omissions",
    "fence",
    "bytes",
    "limits",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.proposer-evidence.v1"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "commit"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      }
    },
    "taskFamily": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "replicateSetSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "divergenceSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "patternsSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "baselineSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lessons": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "description": "Digests of the improvement-lesson-v1 records served under LESSONS/, oldest first."
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "journalRevision",
          "outcome",
          "trajectoryFile",
          "trajectoryLines"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^(replicate|journey)-[0-9]{2}$"
          },
          "journalRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "trajectoryFile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "trajectoryLines": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^wringer/evidence/[^\\s]+$",
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heldOutIds",
        "oracleDigests",
        "denyGlobs"
      ],
      "properties": {
        "heldOutIds": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "oracleDigests": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "denyGlobs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "description": "What may never reach a proposer. Operator-private: the record stays in the private directory and is never served to a model."
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
