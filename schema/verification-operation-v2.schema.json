{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/verification-operation-v2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.verification-operation.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "request": {
      "type": "object",
      "properties": {
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedCandidateIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "idempotencyKey",
        "expectedRevision",
        "expectedCandidateIdentity"
      ],
      "additionalProperties": false
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "string",
      "pattern": "^\\.wringer/runs/verification-[a-f0-9-]{36}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "jobId",
    "sequence",
    "at",
    "request",
    "deadline",
    "evidence"
  ],
  "additionalProperties": false
}
