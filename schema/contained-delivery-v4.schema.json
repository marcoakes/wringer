{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/contained-delivery-v4.schema.json",
  "title": "Contained delivery manifest v4",
  "description": "Additive v4 evidence for plan v3 assertion checks, bounded repair observations and pinned worker playbooks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "journeyId",
    "createdAt",
    "source",
    "planSha256",
    "acceptanceSha256",
    "authoritySha256",
    "environmentSha256",
    "journal",
    "baseline",
    "verification",
    "roles",
    "humanCriteria",
    "judge",
    "counts",
    "publication",
    "evidencePath",
    "auditCommand",
    "falsify",
    "limits",
    "contracts",
    "viewSha256",
    "sourceReview",
    "engineering"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.contained-delivery.v4"
    },
    "id": {
      "type": "string",
      "pattern": "^contained-[a-f0-9]{24}$"
    },
    "journeyId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "baseCommit",
        "codeCommit",
        "tree"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "baseCommit": {
          "$ref": "#/$defs/git"
        },
        "codeCommit": {
          "$ref": "#/$defs/git"
        },
        "tree": {
          "$ref": "#/$defs/git"
        }
      }
    },
    "planSha256": {
      "$ref": "#/$defs/digest"
    },
    "acceptanceSha256": {
      "$ref": "#/$defs/digest"
    },
    "authoritySha256": {
      "$ref": "#/$defs/digest"
    },
    "environmentSha256": {
      "$ref": "#/$defs/digest"
    },
    "viewSha256": {
      "$ref": "#/$defs/digest"
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventCount",
        "headSha256",
        "sourceHeadSha256"
      ],
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "headSha256": {
          "$ref": "#/$defs/digest"
        },
        "sourceHeadSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "baseline": {
      "$ref": "#/$defs/verification"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "roles": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,180}$"
      },
      "uniqueItems": true
    },
    "humanCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "judge": {
      "type": [
        "object",
        "null"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "proved",
        "human"
      ],
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "proved": {
          "type": "integer",
          "minimum": 0
        },
        "human": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceBranch",
        "targetBranch"
      ],
      "properties": {
        "sourceBranch": {
          "type": "string",
          "minLength": 1
        },
        "targetBranch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidencePath": {
      "type": "string",
      "pattern": "^\\.wringer/deliveries/contained-[a-f0-9]{24}$"
    },
    "auditCommand": {
      "type": "string"
    },
    "falsify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "command": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view",
        "certificate",
        "documents",
        "board"
      ],
      "properties": {
        "view": {
          "const": "wringer.contained-delivery-view.v2"
        },
        "certificate": {
          "const": "wringer.contained-certificate.v2"
        },
        "documents": {
          "const": "wringer.contained-documents.v4"
        },
        "board": {
          "const": "wringer.contained-board.v3"
        }
      }
    },
    "sourceReview": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt",
            "sha256",
            "findings"
          ],
          "properties": {
            "receipt": {
              "const": "source-inspection.json"
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            },
            "findings": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        }
      ]
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "researchPurpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "sha256"],
      "properties": {
        "receipt": { "const": "research-purpose.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "sha256",
        "playbook",
        "adoption",
        "checks",
        "decisions"
      ],
      "properties": {
        "receipt": {
          "const": "engineering.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adoption": { "type": ["object", "null"] },
        "playbook": {
          "type": [
            "object",
            "null"
          ]
        },
        "checks": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "level"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "level": {
                "enum": [
                  "command",
                  "assertions"
                ]
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "phase",
              "action",
              "reason",
              "sha256"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "phase": {
                "enum": [
                  "checks",
                  "judge"
                ]
              },
              "action": {
                "enum": [
                  "continue",
                  "warn",
                  "stop"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 4000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "candidateCommit",
        "candidateTree",
        "acceptanceSha256",
        "runtimeId",
        "image",
        "checks",
        "regressions",
        "evidenceRef",
        "checkEvidence",
        "repair"
      ],
      "properties": {
        "schema_version": {
          "const": "wringer.contained-verification.v2"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unavailable"
          ]
        },
        "candidateCommit": {
          "$ref": "#/$defs/git"
        },
        "candidateTree": {
          "$ref": "#/$defs/git"
        },
        "acceptanceSha256": {
          "$ref": "#/$defs/digest"
        },
        "runtimeId": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "regressions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evidenceRef": {
          "type": "string",
          "pattern": "^receipts/[A-Za-z0-9_.-]+$"
        },
        "checkEvidence": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object"
          }
        },
        "repair": {
          "type": "object",
          "required": [
            "schema_version",
            "sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "wringer.repair-packet.v1"
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      }
    }
  }
}
