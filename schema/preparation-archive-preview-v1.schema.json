{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/preparation-archive-preview-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.preparation-archive-preview.v1"
    },
    "selected": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "acceptance",
            "profile"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}\\.json$"
          },
          "identity": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "name",
          "identity"
        ],
        "additionalProperties": false
      }
    },
    "dataIdentity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "action": {
      "const": "retain-incomplete-local-preparation"
    },
    "discardedAuthority": {
      "const": false
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "selected",
    "registrations",
    "dataIdentity",
    "bytes",
    "entries",
    "action",
    "discardedAuthority",
    "note",
    "identity"
  ],
  "additionalProperties": false
}
