{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/proposal-lineage-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wringer.proposal-lineage.v1"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "parentJobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "rootJobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "parentRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposalIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "jobId",
    "parentJobId",
    "rootJobId",
    "parentRevision",
    "proposalIdentity"
  ],
  "additionalProperties": false
}
