{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/authorable-proposal-v1.schema.json",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "kind": {
            "enum": [
              "check",
              "human"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "show": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "maxItems": 256,
                "minItems": 1
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            },
            "required": [
              "id",
              "argv",
              "cwd",
              "timeout_seconds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "quote",
          "kind",
          "required"
        ],
        "additionalProperties": false
      },
      "maxItems": 64,
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 64
          }
        },
        "required": [
          "id",
          "criteria"
        ],
        "additionalProperties": false
      },
      "maxItems": 64,
      "minItems": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "writable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 64,
          "minItems": 1
        }
      },
      "required": [
        "writable"
      ],
      "additionalProperties": false
    },
    "ceilings": {
      "type": "object",
      "properties": {
        "max_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "max_worker_turns": {
          "type": "integer",
          "minimum": 0
        },
        "max_judge_turns": {
          "type": "integer",
          "minimum": 0
        },
        "max_planner_turns": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "session_timeout_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 32
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 32
    }
  },
  "required": [
    "intent",
    "title"
  ],
  "additionalProperties": false
}
