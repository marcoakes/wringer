{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/experiment-result-v1.schema.json",
  "title": "experiment-result-v1",
  "description": "Private bounded research record. Structural validity is not live efficacy, independent human presence or production execution/publication authority. Application readers additionally validate exact source/plan/evidence identity and chronology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experimentSha256",
    "evidenceRevision",
    "eligibility",
    "findings",
    "plannedTrials",
    "recordedTrials",
    "liveTrials",
    "fixtureTrials",
    "missingTrials",
    "pairs",
    "heldOut",
    "cost",
    "limits",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.experiment-result.v1"
    },
    "experimentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "eligibility": {
      "enum": [
        "eligible",
        "ineligible",
        "inconclusive"
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "plannedTrials": {
      "type": "integer",
      "minimum": 2,
      "maximum": 128
    },
    "recordedTrials": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "liveTrials": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "fixtureTrials": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "missingTrials": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,79}$"
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "repetition",
          "split",
          "baseline",
          "candidate",
          "improvement",
          "regressions"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "repetition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "split": {
            "enum": [
              "development",
              "held-out"
            ]
          },
          "baseline": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "improvement": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "regressions": {
            "type": "array",
            "minItems": 0,
            "maxItems": 1024,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      }
    },
    "heldOut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairs",
        "independentTasks",
        "improvements",
        "regressions",
        "ties",
        "meanImprovement",
        "signProbability"
      ],
      "properties": {
        "pairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "independentTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "improvements": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "regressions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "ties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "meanImprovement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "signProbability": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cost": {
      "type": "null"
    },
    "limits": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
