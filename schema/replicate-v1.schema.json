{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wringer.dev/schema/replicate-v1.schema.json",
  "description": "One replicate's observed outcome; failures, interruptions and unstarted slots stay in the denominator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "replicateSetSha256",
    "slot",
    "startedAt",
    "finishedAt",
    "evidenceKind",
    "runtimeKind",
    "outcome",
    "journeyRevision",
    "candidateCommit",
    "candidateTree",
    "workerAttempts",
    "roleSessions",
    "checks",
    "judge",
    "runtimeIds",
    "stopReason",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.replicate.v1"
    },
    "replicateSetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "planSha256",
        "reservedSessions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^replicate-[0-9]{2}$"
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reservedSessions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "finishedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "evidenceKind": {
      "enum": [
        "live",
        "deterministic-fixture"
      ]
    },
    "runtimeKind": {
      "enum": [
        "apple-container",
        "gvisor-kubernetes",
        "trusted-local"
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "human-hold",
        "stopped",
        "infrastructure-failed",
        "uncertain",
        "not-started"
      ]
    },
    "journeyRevision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateTree": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "workerAttempts": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "roleSessions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unavailable",
              "not-run"
            ]
          }
        }
      }
    },
    "judge": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "met"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "met": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "runtimeIds": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "stopReason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "title": "replicate-v1"
}
