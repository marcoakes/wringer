{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only contained graph status",
  "description": "Derived from the replayed graph history. It grants nothing: the named command still revalidates revision, input and prepared identity under the graph lock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph",
    "revision",
    "phase",
    "reason",
    "cursor",
    "startedAt",
    "deadline",
    "allowance",
    "nodes",
    "next"
  ],
  "properties": {
    "schema_version": {
      "const": "wringer.contained-graph-status.v1"
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "repository"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 80
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "commit"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "commit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase": {
      "enum": [
        "pending",
        "human-hold",
        "send-hold",
        "uncertain",
        "complete",
        "failed",
        "expired"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "cursor": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleSessions",
        "verificationAttempts",
        "wallClockSeconds"
      ],
      "properties": {
        "roleSessions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reserved",
            "ceiling"
          ],
          "properties": {
            "reserved": {
              "type": "integer",
              "minimum": 0
            },
            "ceiling": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "verificationAttempts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reserved",
            "ceiling"
          ],
          "properties": {
            "reserved": {
              "type": "integer",
              "minimum": 0
            },
            "ceiling": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "wallClockSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "required",
          "input",
          "state",
          "outcome",
          "route",
          "candidate",
          "evidenceSha256",
          "child"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "loop",
              "check",
              "router",
              "human-hold",
              "delivery"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "input": {
            "type": "string"
          },
          "state": {
            "enum": [
              "not-reached",
              "evaluated-inline",
              "reserved",
              "dispatched",
              "decided",
              "prepared",
              "sent",
              "resulted",
              "complete"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "route": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "to",
                  "via"
                ],
                "properties": {
                  "to": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "maxLength": 80
                  },
                  "via": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$",
                      "maxLength": 80
                    }
                  }
                }
              }
            ]
          },
          "candidate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "commit",
                  "tree",
                  "owner"
                ],
                "properties": {
                  "commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
                  },
                  "tree": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
                  },
                  "owner": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "maxLength": 80
                  }
                }
              }
            ]
          },
          "evidenceSha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          },
          "child": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "node",
        "prompt",
        "inputSha256",
        "preparedSha256",
        "command"
      ],
      "properties": {
        "action": {
          "enum": [
            "resume",
            "decide",
            "send",
            "inspect-child",
            "none"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputSha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "preparedSha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
