{
  "name": "@wringer/temporal-adapter",
  "version": "1.0.0-alpha.34",
  "private": true,
  "description": "An optional Node worker that runs Wringer's contained-graph kernel as Temporal workflows. The Bun harness does not need it.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=240000 --test-force-exit 'test/*.test.mjs'"
  },
  "dependencies": {
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "protobufjs": "8.8.0"
  }
}
