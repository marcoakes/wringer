# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# builds — ANCHORED to the repo root, which is the only place they are.
# Unanchored, `build/` matches a directory of that name at any depth, and
# M3's graph has a node called `build`: its `nodes/build/loop.ref.json` was
# on disk, complete against the bundle's own digests, and silently absent
# from every clone. Local green, CI red, and the bundle refused itself.
/dist/
/build/

# runtime artifacts — evidence bundles are local by design (nothing
# uploads, ever); the committed demo bundle lives in .wringer.example/
.wringer/
*.sqlite
*.sqlite-journal

# benchmark arms — a real agent run writes git worktrees and megabytes of
# agent logs in here. The record of a run is its capture document
# (docs/benchmark-first-run.md); the tree is not committable anyway, because
# the worktrees' .git files are absolute paths into one machine.
/benchmark/results/
/results/

# corpus — generated task files name absolute clone and venv paths, so they are
# a machine's, not the project's. The reviewable artifacts (corpus.yaml, the
# held-out tests, the upstream statements) are all committed.
/benchmark/corpus/tasks/

# env & secrets
.env
.env.*
!.env.example

# personal Claude Code settings (permission allowlist) — not the team's
.claude/settings.local.json

# uv's resolver lock. This project publishes a library, not an application:
# `pyproject.toml` declares the ranges that are the contract, and a pinned
# resolution of one machine's transitive tree is not one. It has been
# untracked three times (8738240, 80b7822, and this) and re-added three times
# by a `git add -A`, which is why it is ignored now rather than untracked a
# fourth time — the instruction "commit with explicit pathspecs" is a habit
# and this is a mechanism.
uv.lock

# editor/os
.DS_Store
.idea/
.vscode/
*.log
# ...except the committed demo bundle, whose gate logs ARE the demonstration
!.wringer.example/**/*.log

# `python -m build` output. Never committed; the release workflow builds it fresh.
build/
